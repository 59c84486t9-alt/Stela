# SPDX-License-Identifier: MIT
option(
  'compilers',
  type : 'array',
  choices : ['nvidia', 'amd', 'intel'],
  value : ['nvidia', 'amd', 'intel'],
  description : 'Vendor shader compilers to build, with their Stela targets and probes',
)
option(
  'amd-llvm',
  type : 'boolean',
  value : false,
  description : 'Build Mesa\'s AMD LLVM backend for the CDNA targets (requires matching LLVM 23 development files)',
)
option(
  'air-llvm-library',
  type : 'string',
  value : '',
  description : 'Absolute LLVM 23 shared-library path for the optional native AIR compiler; empty disables it',
)
option(
  'metal-input-library',
  type : 'string',
  value : '',
  description : 'Matching hosted Rust input static library for the optional Darwin Metal library assembler',
)
