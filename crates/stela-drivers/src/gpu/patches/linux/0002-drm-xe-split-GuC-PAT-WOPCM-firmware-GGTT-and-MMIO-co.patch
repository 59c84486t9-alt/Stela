diff --git a/drivers/gpu/drm/xe/xe_uc_fw_catalog.h b/drivers/gpu/drm/xe/xe_uc_fw_catalog.h
new file mode 100644
index 0000000000000000000000000000000000000000..09ad4f84ce04530050f4a93bde24c82550c7d391
--- /dev/null
+++ b/drivers/gpu/drm/xe/xe_uc_fw_catalog.h
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: MIT */
+/* Copyright © 2022 Intel Corporation */
+#ifndef XE_UC_FW_CATALOG_H
+#define XE_UC_FW_CATALOG_H
+#include <linux/array_size.h>
+#include <linux/stringify.h>
+#include <linux/types.h>
+
+#include "xe_gt_type.h"
+#include "xe_platform_types.h"
+
+struct uc_fw_entry {
+	enum xe_platform platform;
+	enum xe_gt_type gt_type;
+
+	struct {
+		const char *path;
+		u16 major;
+		u16 minor;
+		u16 patch;
+		bool full_ver_required;
+	};
+};
+
+struct fw_blobs_by_type {
+	const struct uc_fw_entry *entries;
+	u32 count;
+};
+
+/*
+ * Add an "ANY" define just to convey the meaning it's given here.
+ */
+#define XE_GT_TYPE_ANY XE_GT_TYPE_UNINITIALIZED
+
+#define XE_GUC_FIRMWARE_DEFS(fw_def, mmp_ver, major_ver)					\
+	fw_def(PANTHERLAKE,	GT_TYPE_ANY,	major_ver(xe,	guc,	ptl,	70, 54, 0))	\
+	fw_def(BATTLEMAGE,	GT_TYPE_ANY,	major_ver(xe,	guc,	bmg,	70, 54, 0))	\
+	fw_def(LUNARLAKE,	GT_TYPE_ANY,	major_ver(xe,	guc,	lnl,	70, 53, 0))	\
+	fw_def(METEORLAKE,	GT_TYPE_ANY,	major_ver(i915,	guc,	mtl,	70, 53, 0))	\
+	fw_def(DG2,		GT_TYPE_ANY,	major_ver(i915,	guc,	dg2,	70, 53, 0))	\
+	fw_def(DG1,		GT_TYPE_ANY,	major_ver(i915,	guc,	dg1,	70, 44, 1))	\
+	fw_def(ALDERLAKE_N,	GT_TYPE_ANY,	major_ver(i915,	guc,	tgl,	70, 44, 1))	\
+	fw_def(ALDERLAKE_P,	GT_TYPE_ANY,	major_ver(i915,	guc,	adlp,	70, 44, 1))	\
+	fw_def(ALDERLAKE_S,	GT_TYPE_ANY,	major_ver(i915,	guc,	tgl,	70, 44, 1))	\
+	fw_def(ROCKETLAKE,	GT_TYPE_ANY,	major_ver(i915,	guc,	tgl,	70, 44, 1))	\
+	fw_def(TIGERLAKE,	GT_TYPE_ANY,	major_ver(i915,	guc,	tgl,	70, 44, 1))
+
+#define XE_HUC_FIRMWARE_DEFS(fw_def, mmp_ver, no_ver)		\
+	fw_def(PANTHERLAKE,	GT_TYPE_ANY,	no_ver(xe,	huc,		ptl))		\
+	fw_def(BATTLEMAGE,	GT_TYPE_ANY,	no_ver(xe,	huc,		bmg))		\
+	fw_def(LUNARLAKE,	GT_TYPE_ANY,	no_ver(xe,	huc,		lnl))		\
+	fw_def(METEORLAKE,	GT_TYPE_ANY,	no_ver(i915,	huc_gsc,	mtl))		\
+	fw_def(DG1,		GT_TYPE_ANY,	no_ver(i915,	huc,		dg1))		\
+	fw_def(ALDERLAKE_P,	GT_TYPE_ANY,	no_ver(i915,	huc,		tgl))		\
+	fw_def(ALDERLAKE_S,	GT_TYPE_ANY,	no_ver(i915,	huc,		tgl))		\
+	fw_def(ROCKETLAKE,	GT_TYPE_ANY,	no_ver(i915,	huc,		tgl))		\
+	fw_def(TIGERLAKE,	GT_TYPE_ANY,	no_ver(i915,	huc,		tgl))
+
+/* for the GSC FW we match the compatibility version and not the release one */
+#define XE_GSC_FIRMWARE_DEFS(fw_def, major_ver)		\
+	fw_def(PANTHERLAKE,	GT_TYPE_ANY,	major_ver(xe,	gsc,	ptl,	105, 1, 0))	\
+	fw_def(LUNARLAKE,	GT_TYPE_ANY,	major_ver(xe,	gsc,	lnl,	104, 1, 0))	\
+	fw_def(METEORLAKE,	GT_TYPE_ANY,	major_ver(i915,	gsc,	mtl,	102, 1, 0))
+
+#define MAKE_FW_PATH(dir__, uc__, shortname__, version__)			\
+	__stringify(dir__) "/" __stringify(shortname__) "_" __stringify(uc__) version__ ".bin"
+
+#define fw_filename_mmp_ver(dir_, uc_, shortname_, a, b, c)			\
+	MAKE_FW_PATH(dir_, uc_, shortname_, "_" __stringify(a ## . ## b ## . ## c))
+#define fw_filename_major_ver(dir_, uc_, shortname_, a, b, c)			\
+	MAKE_FW_PATH(dir_, uc_, shortname_, "_" __stringify(a))
+#define fw_filename_no_ver(dir_, uc_, shortname_)				\
+	MAKE_FW_PATH(dir_, uc_, shortname_, "")
+#define fw_filename_gsc(dir_, uc_, shortname_, a, b, c)				\
+	MAKE_FW_PATH(dir_, uc_, shortname_, "_" __stringify(b))
+
+#define uc_fw_entry_mmp_ver(dir_, uc_, shortname_, a, b, c)			\
+	{ fw_filename_mmp_ver(dir_, uc_, shortname_, a, b, c),			\
+	  a, b, c, true }
+#define uc_fw_entry_major_ver(dir_, uc_, shortname_, a, b, c)			\
+	{ fw_filename_major_ver(dir_, uc_, shortname_, a, b, c),		\
+	  a, b, c }
+#define uc_fw_entry_no_ver(dir_, uc_, shortname_)				\
+	{ fw_filename_no_ver(dir_, uc_, shortname_),				\
+	  0, 0 }
+#define uc_fw_entry_gsc(dir_, uc_, shortname_, a, b, c)				\
+	{ fw_filename_gsc(dir_, uc_, shortname_, a, b, c),			\
+	  a, b, c }
+
+/* All blobs need to be declared via MODULE_FIRMWARE() */
+#define XE_UC_MODULE_FIRMWARE(platform__, gt_type__, fw_filename)		\
+	MODULE_FIRMWARE(fw_filename);
+
+#define XE_UC_FW_ENTRY(platform__, gt_type__, entry__)				\
+	{									\
+		.platform = XE_ ## platform__,					\
+		.gt_type = XE_ ## gt_type__,					\
+		entry__,							\
+	},
+
+/* Caller retains original type/GT assertions or validates native inputs. */
+static inline void xe_uc_fw_select_default(enum xe_platform p,
+		enum xe_gt_type gt_type, struct xe_uc_fw *uc_fw)
+{
+	static const struct uc_fw_entry entries_guc[] = {
+		XE_GUC_FIRMWARE_DEFS(XE_UC_FW_ENTRY,
+				     uc_fw_entry_mmp_ver,
+				     uc_fw_entry_major_ver)
+	};
+	static const struct uc_fw_entry entries_huc[] = {
+		XE_HUC_FIRMWARE_DEFS(XE_UC_FW_ENTRY,
+				     uc_fw_entry_mmp_ver,
+				     uc_fw_entry_no_ver)
+	};
+	static const struct uc_fw_entry entries_gsc[] = {
+		XE_GSC_FIRMWARE_DEFS(XE_UC_FW_ENTRY, uc_fw_entry_gsc)
+	};
+	static const struct fw_blobs_by_type blobs_all[XE_UC_FW_NUM_TYPES] = {
+		[XE_UC_FW_TYPE_GUC] = { entries_guc, ARRAY_SIZE(entries_guc) },
+		[XE_UC_FW_TYPE_HUC] = { entries_huc, ARRAY_SIZE(entries_huc) },
+		[XE_UC_FW_TYPE_GSC] = { entries_gsc, ARRAY_SIZE(entries_gsc) },
+	};
+	const struct uc_fw_entry *entries;
+	u32 count;
+	int i;
+
+	entries = blobs_all[uc_fw->type].entries;
+	count = blobs_all[uc_fw->type].count;
+
+	for (i = 0; i < count && p <= entries[i].platform; i++) {
+		if (p != entries[i].platform)
+			continue;
+
+		if (entries[i].gt_type != XE_GT_TYPE_ANY &&
+		    entries[i].gt_type != gt_type)
+			continue;
+
+		uc_fw->path = entries[i].path;
+		uc_fw->versions.wanted.major = entries[i].major;
+		uc_fw->versions.wanted.minor = entries[i].minor;
+		uc_fw->versions.wanted.patch = entries[i].patch;
+		uc_fw->full_ver_required = entries[i].full_ver_required;
+
+		if (uc_fw->type == XE_UC_FW_TYPE_GSC)
+			uc_fw->versions.wanted_type = XE_UC_FW_VER_COMPATIBILITY;
+		else
+			uc_fw->versions.wanted_type = XE_UC_FW_VER_RELEASE;
+
+		break;
+	}
+}
+#endif
diff --git a/drivers/gpu/drm/xe/xe_uc_fw_cpd.h b/drivers/gpu/drm/xe/xe_uc_fw_cpd.h
new file mode 100644
index 0000000000000000000000000000000000000000..812703cd272fcd7dbf7dd6461c62bd30cc93b2a3
--- /dev/null
+++ b/drivers/gpu/drm/xe/xe_uc_fw_cpd.h
@@ -0,0 +1,144 @@
+/* SPDX-License-Identifier: MIT */
+/* Copyright © 2022 Intel Corporation */
+#ifndef XE_UC_FW_CPD_H
+#define XE_UC_FW_CPD_H
+#ifndef XE_UC_FW_CPD_ENTRY_EQUAL
+#error "CPD requires the actual caller's bounded name equality binding"
+#endif
+/* Original parser policy. No BO, load state, signature or device service.
+ * The original Linux caller retains real logging, assertions and GSC writes.
+ * Native callers must preflight input arithmetic/iteration before this core. */
+enum xe_uc_fw_cpd_diagnostic {
+	XE_UC_FW_CPD_HEADER_LENGTH,
+	XE_UC_FW_CPD_SHORT_IMAGE,
+	XE_UC_FW_CPD_MISSING_MANIFEST,
+};
+struct xe_uc_fw_cpd_ops {
+	void *context;
+	void (*report)(void *, enum xe_uc_fw_cpd_diagnostic, const struct xe_uc_fw *, size_t, size_t);
+	void (*invariant)(void *, bool);
+	int (*parse_css)(void *, struct xe_uc_fw *, const void *, size_t);
+	void (*gsc_manifest)(void *, struct xe_uc_fw *, const struct gsc_manifest_header *);
+};
+static bool is_cpd_header(const void *data)
+{
+	const struct gsc_cpd_header_v2 *header = data;
+
+	return header->header_marker == GSC_CPD_HEADER_MARKER;
+}
+
+static u32 entry_offset(const struct gsc_cpd_header_v2 *header, const char *name, size_t name_bytes)
+{
+	const struct gsc_cpd_entry *entry;
+	int i;
+
+	entry = (void *)header + header->header_length;
+
+	for (i = 0; i < header->num_of_entries; i++, entry++)
+		if (XE_UC_FW_CPD_ENTRY_EQUAL(entry->name, name, name_bytes))
+			return entry->offset & GSC_CPD_ENTRY_OFFSET_MASK;
+
+	return 0;
+}
+
+/* Refer to the "GSC-based Firmware Layout" documentation entry for details */
+static int xe_uc_fw_cpd_parse(struct xe_uc_fw *uc_fw, const void *data, size_t size,
+			    const char *manifest_entry, size_t manifest_bytes,
+			    const char *css_entry, size_t css_bytes, enum xe_platform platform,
+			    const struct xe_uc_fw_cpd_ops *ops)
+{
+	const struct gsc_cpd_header_v2 *header = data;
+	struct xe_uc_fw_version *release = &uc_fw->versions.found[XE_UC_FW_VER_RELEASE];
+	const struct gsc_manifest_header *manifest;
+	size_t min_size = sizeof(*header);
+	u32 offset;
+
+	/* manifest_entry is mandatory, css_entry is optional */
+	ops->invariant(ops->context, manifest_entry && manifest_bytes && manifest_bytes <= 12);
+	ops->invariant(ops->context, !css_entry || (css_bytes && css_bytes <= 12));
+
+	if (size < min_size || !is_cpd_header(header))
+		return -ENOENT;
+
+	if (header->header_length < sizeof(struct gsc_cpd_header_v2)) {
+		ops->report(ops->context, XE_UC_FW_CPD_HEADER_LENGTH, uc_fw, header->header_length, sizeof(*header));
+		return -EINVAL;
+	}
+
+	min_size = header->header_length + sizeof(struct gsc_cpd_entry) * header->num_of_entries;
+	if (size < min_size) {
+		ops->report(ops->context, XE_UC_FW_CPD_SHORT_IMAGE, uc_fw, size, min_size);
+		return -ENODATA;
+	}
+
+	/* Look for the manifest first */
+	offset = entry_offset(header, manifest_entry, manifest_bytes);
+	if (!offset) {
+		ops->report(ops->context, XE_UC_FW_CPD_MISSING_MANIFEST, uc_fw, 0, 0);
+		return -ENODATA;
+	}
+
+	min_size = offset + sizeof(struct gsc_manifest_header);
+	if (size < min_size) {
+		ops->report(ops->context, XE_UC_FW_CPD_SHORT_IMAGE, uc_fw, size, min_size);
+		return -ENODATA;
+	}
+
+	manifest = data + offset;
+
+	release->major = manifest->fw_version.major;
+	release->minor = manifest->fw_version.minor;
+	release->patch = manifest->fw_version.hotfix;
+
+	if (uc_fw->type == XE_UC_FW_TYPE_GSC) {
+		ops->invariant(ops->context, ops->gsc_manifest);
+		ops->gsc_manifest(ops->context, uc_fw, manifest);
+	}
+
+	/* then optionally look for the css header */
+	if (css_entry) {
+		int ret;
+
+		/*
+		 * This section does not contain a CSS entry on DG2. We
+		 * don't support DG2 HuC right now, so no need to handle
+		 * it, just add a reminder in case that changes.
+		 */
+		ops->invariant(ops->context, platform != XE_DG2);
+
+		offset = entry_offset(header, css_entry, css_bytes);
+
+		/* the CSS header parser will check that the CSS header fits */
+		if (offset > size) {
+			ops->report(ops->context, XE_UC_FW_CPD_SHORT_IMAGE, uc_fw, size, offset);
+			return -ENODATA;
+		}
+
+		ret = ops->parse_css(ops->context, uc_fw, data + offset, size - offset);
+		if (ret)
+			return ret;
+
+		uc_fw->css_offset = offset;
+	}
+
+	uc_fw->has_gsc_headers = true;
+
+	return 0;
+}
+
+/* Original HuC CPD-first dispatch. Only absent CPD falls through to CSS. */
+static int xe_uc_fw_huc_parse(struct xe_uc_fw *uc_fw, const void *data, size_t size,
+			    enum xe_platform platform, const struct xe_uc_fw_cpd_ops *ops)
+{
+	int ret;
+
+	ret = xe_uc_fw_cpd_parse(uc_fw, data, size, "HUCP.man", sizeof("HUCP.man"),
+			       "huc_fw", sizeof("huc_fw"), platform, ops);
+	if (!ret || ret != -ENOENT)
+		return ret;
+
+	return ops->parse_css(ops->context, uc_fw, data, size);
+}
+
+#undef XE_UC_FW_CPD_ENTRY_EQUAL
+#endif
diff --git a/drivers/gpu/drm/xe/xe_uc_fw_css.h b/drivers/gpu/drm/xe/xe_uc_fw_css.h
new file mode 100644
index 0000000000000000000000000000000000000000..384b28e94e5309222ab443760f550ebdb9e961a3
--- /dev/null
+++ b/drivers/gpu/drm/xe/xe_uc_fw_css.h
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * Copyright © 2022 Intel Corporation
+ */
+#ifndef XE_UC_FW_CSS_H
+#define XE_UC_FW_CSS_H
+#include <linux/bitfield.h>
+#include <linux/errno.h>
+#include <linux/types.h>
+
+/* Required diagnostic/invariant adapters; the original caller retains real
+ * logging and GT assertions. No device, BO, status or OS service is emulated. */
+enum xe_uc_fw_css_diagnostic {
+	XE_UC_FW_CSS_GUC_TOO_OLD,
+	XE_UC_FW_CSS_VERSION_MISMATCH,
+	XE_UC_FW_CSS_RECOMMENDED_NEWER,
+	XE_UC_FW_CSS_SHORT_HEADER,
+	XE_UC_FW_CSS_HEADER_SIZE,
+	XE_UC_FW_CSS_SHORT_IMAGE,
+};
+struct xe_uc_fw_css_ops {
+	void *context;
+	void (*report)(void *, enum xe_uc_fw_css_diagnostic,
+		       const struct xe_uc_fw *, size_t, size_t);
+	void (*invariant)(void *, bool);
+};
+static int xe_uc_fw_css_read_guc_info(struct xe_uc_fw *uc_fw, struct uc_css_guc_info *guc_info,
+		const struct xe_uc_fw_css_ops *ops)
+{
+	struct xe_uc_fw_version *release = &uc_fw->versions.found[XE_UC_FW_VER_RELEASE];
+	struct xe_uc_fw_version *compatibility = &uc_fw->versions.found[XE_UC_FW_VER_COMPATIBILITY];
+
+	ops->invariant(ops->context, uc_fw->type == XE_UC_FW_TYPE_GUC);
+
+	/* We don't support GuC releases older than 70.29.2 */
+	if (MAKE_GUC_VER_STRUCT(*release) < MAKE_GUC_VER(70, 29, 2)) {
+		ops->report(ops->context, XE_UC_FW_CSS_GUC_TOO_OLD, uc_fw, 0, 0);
+		return -EINVAL;
+	}
+
+	compatibility->major = FIELD_GET(CSS_SW_VERSION_UC_MAJOR, guc_info->submission_version);
+	compatibility->minor = FIELD_GET(CSS_SW_VERSION_UC_MINOR, guc_info->submission_version);
+	compatibility->patch = FIELD_GET(CSS_SW_VERSION_UC_PATCH, guc_info->submission_version);
+
+	uc_fw->build_type = FIELD_GET(CSS_UKERNEL_INFO_BUILDTYPE, guc_info->ukernel_info);
+	uc_fw->private_data_size = guc_info->private_data_size;
+
+	return 0;
+}
+
+static int xe_uc_fw_css_check_version(struct xe_uc_fw *uc_fw,
+		const struct xe_uc_fw_css_ops *ops)
+{
+	struct xe_uc_fw_version *wanted = &uc_fw->versions.wanted;
+	struct xe_uc_fw_version *found = &uc_fw->versions.found[uc_fw->versions.wanted_type];
+
+	/* Driver has no requirement on any version, any is good. */
+	if (!wanted->major)
+		return 0;
+
+	/*
+	 * If full version is required, both major and minor should match.
+	 * Otherwise, at least the major version.
+	 */
+	if (wanted->major != found->major ||
+	    (uc_fw->full_ver_required &&
+	     ((wanted->minor != found->minor) ||
+	      (wanted->patch != found->patch)))) {
+		ops->report(ops->context, XE_UC_FW_CSS_VERSION_MISMATCH, uc_fw, 0, 0);
+		goto fail;
+	}
+
+	if (wanted->minor > found->minor ||
+	    (wanted->minor == found->minor && wanted->patch > found->patch)) {
+		ops->report(ops->context, XE_UC_FW_CSS_RECOMMENDED_NEWER, uc_fw, 0, 0);
+	}
+
+	return 0;
+
+fail:
+	if (uc_fw->user_overridden)
+		return 0;
+
+	return -ENOEXEC;
+}
+
+static int xe_uc_fw_css_parse(struct xe_uc_fw *uc_fw, const void *fw_data, size_t fw_size,
+		const struct xe_uc_fw_css_ops *ops)
+{
+	struct xe_uc_fw_version *release = &uc_fw->versions.found[XE_UC_FW_VER_RELEASE];
+	struct uc_css_header *css;
+	size_t size;
+
+	/* Check the size of the blob before examining buffer contents */
+	if (unlikely(fw_size < sizeof(struct uc_css_header))) {
+		ops->report(ops->context, XE_UC_FW_CSS_SHORT_HEADER, uc_fw,
+			    fw_size, sizeof(struct uc_css_header));
+		return -ENODATA;
+	}
+
+	css = (struct uc_css_header *)fw_data;
+
+	/* Check integrity of size values inside CSS header */
+	size = (css->header_size_dw - css->rsa_info.key_size_dw - css->rsa_info.modulus_size_dw -
+		css->rsa_info.exponent_size_dw) * sizeof(u32);
+	if (unlikely(size != sizeof(struct uc_css_header))) {
+		ops->report(ops->context, XE_UC_FW_CSS_HEADER_SIZE, uc_fw,
+			    fw_size, sizeof(struct uc_css_header));
+		return -EPROTO;
+	}
+
+	/* uCode size must calculated from other sizes */
+	uc_fw->ucode_size = (css->size_dw - css->header_size_dw) * sizeof(u32);
+
+	/* now RSA */
+	uc_fw->rsa_size = css->rsa_info.key_size_dw * sizeof(u32);
+
+	/* At least, it should have header, uCode and RSA. Size of all three. */
+	size = sizeof(struct uc_css_header) + uc_fw->ucode_size +
+		uc_fw->rsa_size;
+	if (unlikely(fw_size < size)) {
+		ops->report(ops->context, XE_UC_FW_CSS_SHORT_IMAGE, uc_fw, fw_size, size);
+		return -ENOEXEC;
+	}
+
+	/* Get version numbers from the CSS header */
+	release->major = FIELD_GET(CSS_SW_VERSION_UC_MAJOR, css->guc_info.sw_version);
+	release->minor = FIELD_GET(CSS_SW_VERSION_UC_MINOR, css->guc_info.sw_version);
+	release->patch = FIELD_GET(CSS_SW_VERSION_UC_PATCH, css->guc_info.sw_version);
+
+	if (uc_fw->type == XE_UC_FW_TYPE_GUC)
+		return xe_uc_fw_css_read_guc_info(uc_fw, &css->guc_info, ops);
+
+	return 0;
+}
+#endif
