diff --git a/drivers/gpu/drm/xe/xe_mmio_poll.h b/drivers/gpu/drm/xe/xe_mmio_poll.h
new file mode 100644
index 0000000000000000000000000000000000000000..62d27324674c12f287360da556ee79dcc64a338d
--- /dev/null
+++ b/drivers/gpu/drm/xe/xe_mmio_poll.h
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Copyright © 2021-2023 Intel Corporation
+ */
+/* Original masked/deadline/final-reread algorithm; includer binds actual I/O/time. */
+#include <linux/errno.h>
+#include <linux/types.h>
+
+static int XE_MMIO_POLL_NAME(XE_MMIO_POLL_CONTEXT *mmio, struct xe_reg reg, u32 mask, u32 val,
+			    u32 timeout_us, u32 *out_val, bool atomic, bool expect_match)
+{
+	XE_MMIO_POLL_TIME cur = XE_MMIO_POLL_NOW(mmio);
+	const XE_MMIO_POLL_TIME end = XE_MMIO_POLL_ADD_US(cur, timeout_us);
+	int ret = -ETIMEDOUT;
+	s64 wait = 10;
+	u32 read;
+	bool check;
+
+	for (;;) {
+		read = XE_MMIO_POLL_READ(mmio, reg);
+
+		check = (read & mask) == val;
+		if (!expect_match)
+			check = !check;
+
+		if (check) {
+			ret = 0;
+			break;
+		}
+
+		cur = XE_MMIO_POLL_NOW(mmio);
+		if (!XE_MMIO_POLL_BEFORE(cur, end))
+			break;
+
+		if (XE_MMIO_POLL_AFTER(XE_MMIO_POLL_ADD_US(cur, wait), end))
+			wait = XE_MMIO_POLL_DELTA_US(end, cur);
+
+		if (atomic)
+			XE_MMIO_POLL_DELAY(mmio, wait, true);
+		else
+			XE_MMIO_POLL_DELAY(mmio, wait, false);
+		wait <<= 1;
+	}
+
+	if (ret != 0) {
+		read = XE_MMIO_POLL_READ(mmio, reg);
+
+		check = (read & mask) == val;
+		if (!expect_match)
+			check = !check;
+
+		if (check)
+			ret = 0;
+	}
+
+	if (out_val)
+		*out_val = read;
+
+	return ret;
+}
diff --git a/drivers/gpu/drm/xe/xe_mmio_verify.h b/drivers/gpu/drm/xe/xe_mmio_verify.h
new file mode 100644
index 0000000000000000000000000000000000000000..9717b93a4be61442a066fa409c66f54dae313fb2
--- /dev/null
+++ b/drivers/gpu/drm/xe/xe_mmio_verify.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: MIT */
+/* Copyright © 2021-2023 Intel Corporation */
+/* Required compile-time bindings, no fallback access operations. */
+#if !defined(XE_MMIO_VERIFY_NAME) || !defined(XE_MMIO_VERIFY_CONTEXT) || \
+    !defined(XE_MMIO_VERIFY_WRITE) || !defined(XE_MMIO_VERIFY_READ)
+#error "MMIO verification requires actual read/write context bindings"
+#endif
+static int XE_MMIO_VERIFY_NAME(XE_MMIO_VERIFY_CONTEXT *mmio,
+			       struct xe_reg reg, u32 val, u32 mask, u32 eval)
+{
+	u32 reg_val;
+
+	XE_MMIO_VERIFY_WRITE(mmio, reg, val);
+	reg_val = XE_MMIO_VERIFY_READ(mmio, reg);
+
+	return (reg_val & mask) != eval ? -EINVAL : 0;
+}
+#undef XE_MMIO_VERIFY_NAME
+#undef XE_MMIO_VERIFY_CONTEXT
+#undef XE_MMIO_VERIFY_WRITE
+#undef XE_MMIO_VERIFY_READ
