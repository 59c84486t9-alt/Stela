diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_cpu_entries.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_cpu_entries.h
new file mode 100644
index 00000000..95a512fd
--- /dev/null
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_cpu_entries.h
@@ -0,0 +1,84 @@
