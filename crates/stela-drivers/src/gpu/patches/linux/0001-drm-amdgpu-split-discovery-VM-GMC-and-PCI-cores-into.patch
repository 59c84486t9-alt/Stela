+#else
+#include <stdint.h>
+#endif
+
+/* The caller supplies the actual device mask and generation-prepared flags. */
+static inline uint64_t
+amdgpu_gmc_pte_value(uint64_t addr, uint64_t pte_addr_mask, uint64_t flags)
