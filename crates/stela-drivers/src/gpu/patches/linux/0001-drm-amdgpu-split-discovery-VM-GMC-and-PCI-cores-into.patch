+static const struct amdgpu_asic_type_quirk asic_type_quirks[] = {
+	/* differentiate between P10 and P11 asics with the same DID */
+	{0x67FF, 0xE3, CHIP_POLARIS10},
+	{0x67FF, 0xE7, CHIP_POLARIS10},
+	{0x67FF, 0xF3, CHIP_POLARIS10},
+	{0x67FF, 0xF7, CHIP_POLARIS10},
+};
+
+static unsigned long amdgpu_pci_fix_asic_type(unsigned short device, unsigned char revision, unsigned long flags)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(asic_type_quirks); i++) {
+		if (device == asic_type_quirks[i].device &&
+			revision == asic_type_quirks[i].revision) {
+				flags &= ~AMD_ASIC_MASK;
+				flags |= asic_type_quirks[i].type;
+				break;
+			}
+	}
+
+	return flags;
+}
+
+/* Exact original pre-allocation experimental predicate. */
+static inline bool amdgpu_pci_experimental_allowed(unsigned long flags, int option)
+{
+	return !((flags & AMD_EXP_HW_SUPPORT) && !option);
+}
+
+/* Original amdgpu_support_enabled generation decision, without logging or
+ * runtime defaults. Actual build/module-policy inputs belong to the caller. */
+struct amdgpu_pci_support_policy {
+	const char *gen, *param;
+	int module_param;
+	bool support_built;
+	bool support_by_default;
+};
+static inline bool amdgpu_pci_support_policy(enum amd_asic_type family,
+		bool si_built, bool cik_built, int si_support, int cik_support,
+		struct amdgpu_pci_support_policy *policy)
+{
+	switch (family) {
+	case CHIP_TAHITI:
+	case CHIP_PITCAIRN:
+	case CHIP_VERDE:
+	case CHIP_OLAND:
+	case CHIP_HAINAN:
+		*policy = (struct amdgpu_pci_support_policy){
+			"SI", "si_support", si_support, si_built, true};
+		return true;
+	case CHIP_BONAIRE:
+	case CHIP_HAWAII:
+	case CHIP_KAVERI:
+	case CHIP_KABINI:
+	case CHIP_MULLINS:
+		*policy = (struct amdgpu_pci_support_policy){
+			"CIK", "cik_support", cik_support, cik_built, true};
+		return true;
+	default:
+		return false;
+	}
+}
+static inline bool amdgpu_pci_support_allowed(const struct amdgpu_pci_support_policy *policy,
+					     bool radeon_support_built)
+{
+	return policy->support_built &&
+		((policy->module_param == -1 &&
+		  (policy->support_by_default || !radeon_support_built)) ||
+		 policy->module_param == 1);
+}
