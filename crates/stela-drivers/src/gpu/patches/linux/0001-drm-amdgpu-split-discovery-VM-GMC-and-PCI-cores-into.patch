+#ifndef AMDGPU_DISCOVERY_IP_CORE_H
+#define AMDGPU_DISCOVERY_IP_CORE_H
+#ifdef __KERNEL__
+#include <linux/types.h>
+#include <linux/errno.h>
+#else
