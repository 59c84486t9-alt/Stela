From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tyler Smith <74526874+tylertms@users.noreply.github.com>
Date: Thu, 22 Oct 2026 00:00:00 +0000
Subject: [PATCH 4/4] rbtree: keep every pointer bit in the parent word on
 LLP64 targets

---
 include/linux/rbtree.h           | 10 +++++-----
 include/linux/rbtree_augmented.h |  8 ++++----
 include/linux/rbtree_types.h     | 11 +++++++++--
 3 files changed, 18 insertions(+), 11 deletions(-)

diff --git a/include/linux/rbtree.h b/include/linux/rbtree.h
index 48acdc38..2ea2468f 100644
--- a/include/linux/rbtree.h
+++ b/include/linux/rbtree.h
@@ -23,7 +23,7 @@
 #include <linux/stddef.h>
 #include <linux/rcupdate.h>
 
-#define rb_parent(r)   ((struct rb_node *)((r)->__rb_parent_color & ~3))
+#define rb_parent(r)   ((struct rb_node *)((r)->__rb_parent_color & ~(rb_parent_word_t)3))
 
 #define	rb_entry(ptr, type, member) container_of(ptr, type, member)
 
@@ -31,9 +31,9 @@
 
 /* 'empty' nodes are nodes that are known not to be inserted in an rbtree */
 #define RB_EMPTY_NODE(node)  \
-	((node)->__rb_parent_color == (unsigned long)(node))
+	((node)->__rb_parent_color == (rb_parent_word_t)(node))
 #define RB_CLEAR_NODE(node)  \
-	((node)->__rb_parent_color = (unsigned long)(node))
+	((node)->__rb_parent_color = (rb_parent_word_t)(node))
 
 #define RB_EMPTY_LINKED_NODE(lnode)  RB_EMPTY_NODE(&(lnode)->node)
 #define RB_CLEAR_LINKED_NODE(lnode)  ({					\
@@ -92,7 +92,7 @@ extern void rb_replace_node_rcu(struct rb_node *victim, struct rb_node *new,
 static inline void rb_link_node(struct rb_node *node, struct rb_node *parent,
 				struct rb_node **rb_link)
 {
-	node->__rb_parent_color = (unsigned long)parent;
+	node->__rb_parent_color = (rb_parent_word_t)parent;
 	node->rb_left = node->rb_right = NULL;
 
 	*rb_link = node;
@@ -101,7 +101,7 @@ static inline void rb_link_node(struct rb_node *node, struct rb_node *parent,
 static inline void rb_link_node_rcu(struct rb_node *node, struct rb_node *parent,
 				    struct rb_node **rb_link)
 {
-	node->__rb_parent_color = (unsigned long)parent;
+	node->__rb_parent_color = (rb_parent_word_t)parent;
 	node->rb_left = node->rb_right = NULL;
 
 	rcu_assign_pointer(*rb_link, node);
diff --git a/include/linux/rbtree_augmented.h b/include/linux/rbtree_augmented.h
index 6dbc5a1b..35266d76 100644
--- a/include/linux/rbtree_augmented.h
+++ b/include/linux/rbtree_augmented.h
@@ -171,7 +171,7 @@ RB_DECLARE_CALLBACKS(RBSTATIC, RBNAME,					      \
 #define	RB_RED		0
 #define	RB_BLACK	1
 
-#define __rb_parent(pc)    ((struct rb_node *)(pc & ~3))
+#define __rb_parent(pc)    ((struct rb_node *)(pc & ~(rb_parent_word_t)3))
 
 #define __rb_color(pc)     ((pc) & 1)
 #define __rb_is_black(pc)  __rb_color(pc)
@@ -182,13 +182,13 @@ RB_DECLARE_CALLBACKS(RBSTATIC, RBNAME,					      \
 
 static inline void rb_set_parent(struct rb_node *rb, struct rb_node *p)
 {
-	rb->__rb_parent_color = rb_color(rb) + (unsigned long)p;
+	rb->__rb_parent_color = rb_color(rb) + (rb_parent_word_t)p;
 }
 
 static inline void rb_set_parent_color(struct rb_node *rb,
 				       struct rb_node *p, int color)
 {
-	rb->__rb_parent_color = (unsigned long)p + color;
+	rb->__rb_parent_color = (rb_parent_word_t)p + color;
 }
 
 static inline void
@@ -227,7 +227,7 @@ __rb_erase_augmented(struct rb_node *node, struct rb_root *root,
 	struct rb_node *child = node->rb_right;
 	struct rb_node *tmp = node->rb_left;
 	struct rb_node *parent, *rebalance;
-	unsigned long pc;
+	rb_parent_word_t pc;
 
 	if (!tmp) {
 		/*
diff --git a/include/linux/rbtree_types.h b/include/linux/rbtree_types.h
index 3c7ae53e..d7cb0faf 100644
--- a/include/linux/rbtree_types.h
+++ b/include/linux/rbtree_types.h
@@ -2,11 +2,18 @@
 #ifndef _LINUX_RBTREE_TYPES_H
 #define _LINUX_RBTREE_TYPES_H
 
+/* Native LLP64 targets must retain every pointer bit in the tagged word. */
+#ifdef STELA_NATIVE
+typedef __UINTPTR_TYPE__ rb_parent_word_t;
+#else
+typedef unsigned long rb_parent_word_t;
+#endif
+
 struct rb_node {
-	unsigned long  __rb_parent_color;
+	rb_parent_word_t __rb_parent_color;
 	struct rb_node *rb_right;
 	struct rb_node *rb_left;
-} __attribute__((aligned(sizeof(long))));
+} __attribute__((aligned(sizeof(rb_parent_word_t))));
 /* The alignment might seem pointless, but allegedly CRIS needs it */
 
 struct rb_node_linked {
