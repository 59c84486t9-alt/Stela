diff --git a/src/nvidia-modeset/include/nvkms-types.h b/src/nvidia-modeset/include/nvkms-types.h
index f0e917d..614a58f 100644
--- a/src/nvidia-modeset/include/nvkms-types.h
+++ b/src/nvidia-modeset/include/nvkms-types.h
@@ -897,13 +897,37 @@ typedef struct  {
     NvU16 Unused;
 } NVEvoLutEntryRec;
 
+/*
+ * The device addresses LUT slots at 256-byte offsets. Express that serialized
+ * layout independently of CPU alignment: nvInternalAlloc's ordinary metadata
+ * prefix does not promise an over-aligned CPU base. The real LUT surface has
+ * its own RM allocation/mapping and alignment; the temporary CPU shadow is
+ * copied to it by nvUploadDataToLutSurfaceEvo's dword loop.
+ */
+#define NV_EVO_LUT_SLOT_ALIGNMENT 0x100
+#define NV_EVO_LUT_SLOT_BYTES \
+    NV_ALIGN_UP((NV_LUT_VSS_HEADER_SIZE + NV_NUM_EVO_LUT_ENTRIES) * \
+                sizeof(NVEvoLutEntryRec), NV_EVO_LUT_SLOT_ALIGNMENT)
+
 typedef struct {
-    NVEvoLutEntryRec base[NV_LUT_VSS_HEADER_SIZE + NV_NUM_EVO_LUT_ENTRIES];
-    // The output LUT requires 8-bit alignment.
-    NVEvoLutEntryRec output[NV_LUT_VSS_HEADER_SIZE + NV_NUM_EVO_LUT_ENTRIES]
-        __attribute__((aligned(0x100)));
+    union {
+        NVEvoLutEntryRec base[NV_LUT_VSS_HEADER_SIZE + NV_NUM_EVO_LUT_ENTRIES];
+        NvU8 baseSlotStorage[NV_EVO_LUT_SLOT_BYTES];
+    };
+    union {
+        NVEvoLutEntryRec output[NV_LUT_VSS_HEADER_SIZE + NV_NUM_EVO_LUT_ENTRIES];
+        NvU8 outputSlotStorage[NV_EVO_LUT_SLOT_BYTES];
+    };
 } NVEvoLutDataRec;
 
+ct_assert(sizeof(NVEvoLutEntryRec) == 8);
+ct_assert(offsetof(NVEvoLutDataRec, base) == 0);
+ct_assert(offsetof(NVEvoLutDataRec, output) == NV_EVO_LUT_SLOT_BYTES);
+ct_assert((offsetof(NVEvoLutDataRec, output) % NV_EVO_LUT_SLOT_ALIGNMENT) == 0);
+ct_assert(sizeof(NVEvoLutDataRec) == 2 * NV_EVO_LUT_SLOT_BYTES);
+ct_assert(NV_ALIGNOF(NVEvoLutDataRec) <= NV_ALIGNOF(NvU64));
+ct_assert((sizeof(NVEvoLutDataRec) % sizeof(NvU32)) == 0);
+
 typedef struct {
     NvBool rasterLockAcrossProtocolsAllowed :1;
     NvBool adaptiveSyncSdpSupported         :1;
diff --git a/src/nvidia/Makefile b/src/nvidia/Makefile
index 9abfc7c..e0a8104 100644
--- a/src/nvidia/Makefile
+++ b/src/nvidia/Makefile
@@ -21,6 +21,21 @@ GET_COMPILER_TYPE = \
 # and the NVIDIA ID string
 ALL_SRCS = $(SRCS) $(SRCS_CXX)
 ALL_SRCS += $(NVIDSTRING)
+ifeq ($(TARGET_OS),Stela)
+# Stela's shared compiler_builtins owns standard memory symbols. The original
+# gcc_helper aliases reverse them to os_mem_* (and narrow lengths to NvU32),
+# which would recurse when the actual native OS hooks call the shared runtime.
+ALL_SRCS := $(filter-out arch/nvalloc/unix/src/gcc_helper.c,$(ALL_SRCS))
+ALL_SRCS += ../../stela/pci.c ../../stela/memory.c ../../stela/stela_ram_mapping.c
+ALL_SRCS += ../../stela/stela_pages.c ../../stela/stela_page_geometry.c
+ALL_SRCS += ../../stela/stela_ordering.c
+ALL_SRCS += ../../stela/stela_device.c
+ALL_SRCS += ../../stela/stela_mmio.c ../../stela/stela_firmware.c
+ALL_SRCS += ../../stela/stela_primitives.c ../../stela/stela_nvlink_primitives.c
+ALL_SRCS += ../../stela/stela_nvswitch_primitives.c
+ALL_SRCS += ../../stela/stela_nvlink_memory.c
+CFLAGS += -I ../../stela -I $(OUTPUTDIR)
+endif
 
 SRC_COMMON = ../common
 CONDITIONAL_CFLAGS :=
@@ -198,6 +213,15 @@ CFLAGS += $(CONDITIONAL_CFLAGS)
 CC_ONLY_CFLAGS += --std=gnu11
 CXX_ONLY_CFLAGS += --std=gnu++11
 
+ifeq ($(TARGET_OS),Stela)
+# The vendor object rules discard source directories. Refuse collisions across
+# the complete source list instead of silently replacing an RM implementation.
+STELA_OBJECT_BASENAMES := $(notdir $(basename $(ALL_SRCS)))
+ifneq ($(words $(STELA_OBJECT_BASENAMES)),$(words $(sort $(STELA_OBJECT_BASENAMES))))
+$(error duplicate NVIDIA Stela object basenames: $(sort $(foreach name,$(STELA_OBJECT_BASENAMES),$(if $(word 2,$(filter $(name),$(STELA_OBJECT_BASENAMES))),$(name)))))
+endif
+endif
+
 OBJS = $(call BUILD_OBJECT_LIST,$(ALL_SRCS))
 
 # Define how to generate the NVIDIA ID string
@@ -211,7 +235,21 @@ $(foreach src, $(ALL_SRCS), $(eval $(call DEFINE_OBJECT_RULE,TARGET,$(src))))
 NV_KERNEL_O = $(OUTPUTDIR)/nv-kernel.o
 
 .PHONY: all
+ifeq ($(TARGET_OS),Stela)
+ifneq ($(TARGET_ARCH),x86_64)
+$(error Stela currently targets x86_64 physical GPU backends)
+endif
+NV_KERNEL_A = $(OUTPUTDIR)/libnv-kernel.a
+all: $(NV_KERNEL_A)
+
+# COFF objects use the UEFI target's native Win64 C ABI. Keep an archive for
+# Rust's final link; an ELF partial link is not loadable native Stela code.
+$(NV_KERNEL_A): $(OBJS)
+	$(RM) $@
+	$(call quiet_cmd,AR) rcs $@ $(OBJS)
+else
 all: $(NV_KERNEL_O)
+endif
 
 LINKER_SCRIPT = nv-kernel.ld
 
