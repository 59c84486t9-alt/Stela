diff --git a/src/amd/addrlib/meson.build b/src/amd/addrlib/meson.build
index 35ac56890be65cfe1a04567982296cfc3e67a67e..4e6b49f6f7f2a7d59964f75e6b96509a9fb38652 100644
--- a/src/amd/addrlib/meson.build
+++ b/src/amd/addrlib/meson.build
@@ -51,6 +51,12 @@ files_addrlib = files(
 # Skip the addrlib definition of ADDR_FASTCALL so as not to use regparm.
 cpp_args_addrlib = ['-DADDR_FASTCALL=']
 
+# The native Stela host uses Addrlib's original public type/libc path. Apple's
+# private addrExtDef.h and compiler-runtime helper are not host dependencies.
+if with_stela_amd and host_machine.system() == 'darwin'
+  cpp_args_addrlib += '-DHAVE_TSERVER'
+endif
+
 # The SIMD path in addrlib only supports x86 and Aarch64 (NEON).
 if host_machine.cpu_family() in ['x86', 'x86_64', 'aarch64']
   cpp_args_addrlib += '-DADDR_ALLOW_SIMD=1'
diff --git a/src/amd/addrlib/src/core/addrlib.cpp b/src/amd/addrlib/src/core/addrlib.cpp
index 916b77b5309a9a605a342203cdcf860da37ffca0..27d1a3f798ad0f168470ac6e8cade172eda2a5f9 100644
--- a/src/amd/addrlib/src/core/addrlib.cpp
+++ b/src/amd/addrlib/src/core/addrlib.cpp
@@ -17,7 +17,7 @@
 #include "addrlib.h"
 #include "addrcommon.h"
 
-#if defined(__APPLE__)
+#if defined(__APPLE__) && !defined(HAVE_TSERVER)
 
 UINT_32 div64_32(UINT_64 n, UINT_32 base)
 {
@@ -61,7 +61,7 @@ UINT_32 __umoddi3(UINT_64 n, UINT_32 base)
     return div64_32(n, base);
 }
 
-#endif // __APPLE__
+#endif // __APPLE__ && !HAVE_TSERVER
 
 namespace Addr
