Subject: [PATCH] vulkan: split clear color swizzling into a shared header

---
 src/vulkan/runtime/vk_sampler.c  | 16 +------
 src/vulkan/util/vk_color_value.h | 81 ++++++++++++++++++++++++++++++++
 src/vulkan/util/vk_format.c      | 25 +---------
 3 files changed, 85 insertions(+), 37 deletions(-)
 create mode 100644 src/vulkan/util/vk_color_value.h

diff --git a/src/vulkan/runtime/vk_sampler.c b/src/vulkan/runtime/vk_sampler.c
index b57f91c..20a6281 100644
--- a/src/vulkan/runtime/vk_sampler.c
+++ b/src/vulkan/runtime/vk_sampler.c
@@ -25,6 +25,7 @@
 #include "vk_sampler.h"
 #include "vk_device.h"
 #include "vk_format.h"
+#include "vulkan/util/vk_color_value.h"
 #include "vk_limits.h"
 #include "vk_util.h"
 #include "vk_ycbcr_conversion.h"
@@ -53,20 +54,7 @@ vk_border_color_value(VkBorderColor color)
 bool
 vk_border_color_is_int(VkBorderColor color)
 {
-   switch (color) {
-   case VK_BORDER_COLOR_FLOAT_TRANSPARENT_BLACK:
-   case VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK:
-   case VK_BORDER_COLOR_FLOAT_OPAQUE_WHITE:
-   case VK_BORDER_COLOR_FLOAT_CUSTOM_EXT:
-      return false;
-   case VK_BORDER_COLOR_INT_TRANSPARENT_BLACK:
-   case VK_BORDER_COLOR_INT_OPAQUE_BLACK:
-   case VK_BORDER_COLOR_INT_OPAQUE_WHITE:
-   case VK_BORDER_COLOR_INT_CUSTOM_EXT:
-      return true;
-   default:
-      UNREACHABLE("Invalid border color enum");
-   }
+   return vk_color_value_is_int(color);
 }
 
 VkClearColorValue
diff --git a/src/vulkan/util/vk_color_value.h b/src/vulkan/util/vk_color_value.h
new file mode 100644
index 0000000..aee8f04
--- /dev/null
+++ b/src/vulkan/util/vk_color_value.h
@@ -0,0 +1,81 @@
