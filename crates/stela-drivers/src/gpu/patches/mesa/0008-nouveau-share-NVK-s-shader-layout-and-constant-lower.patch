--- /dev/null
+++ b/src/nouveau/compiler/nak_nir_lower_constant.h
@@ -0,0 +1,34 @@
+/*
+ * Copyright © 2022 Collabora Ltd. and Red Hat Inc.
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NAK_NIR_LOWER_CONSTANT_H
+#define NAK_NIR_LOWER_CONSTANT_H 1
+
+#include "nir_builder.h"
+
+/* Lowers load_constant to an ldc_nv from the cbuf the caller bound the
+ * shader's constant data to.
+ */
+static inline bool
+nak_nir_lower_load_constant(nir_builder *b, nir_intrinsic_instr *load,
+                            uint32_t cbuf_idx)
+{
+   assert(load->intrinsic == nir_intrinsic_load_constant);
+
+   uint32_t base = nir_intrinsic_base(load);
+
+   b->cursor = nir_before_instr(&load->instr);
+
+   nir_def *offset = nir_iadd_imm(b, load->src[0].ssa, base);
+   nir_def *data = nir_ldc_nv(b, load->def.num_components, load->def.bit_size,
+                              nir_imm_int(b, cbuf_idx), offset,
+                              .align_mul = nir_intrinsic_align_mul(load),
+                              .align_offset = nir_intrinsic_align_offset(load));
+
+   nir_def_rewrite_uses(&load->def, data);
+
+   return true;
+}
+
+#endif
diff --git a/src/nouveau/compiler/nak_shader_layout.h b/src/nouveau/compiler/nak_shader_layout.h
new file mode 100644
index 0000000000000000000000000000000000000000..5aaa63f57e039e327f9ea509d8b39084525b4839
--- /dev/null
+++ b/src/nouveau/compiler/nak_shader_layout.h
@@ -0,0 +1,93 @@
+/*
+ * Copyright © 2022 Collabora Ltd. and Red Hat Inc.
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NAK_SHADER_LAYOUT_H
+#define NAK_SHADER_LAYOUT_H 1
+
+#include "nak.h"
+#include "util/u_math.h"
+#include "nv_device_info.h"
+#include "cla097.h"
+#include "clc597.h"
+
+#define GF100_SHADER_HEADER_SIZE (20 * 4)
+#define TU102_SHADER_HEADER_SIZE (32 * 4)
+#define NVC0_MAX_SHADER_HEADER_SIZE TU102_SHADER_HEADER_SIZE
+
+/* NVK's shader upload layout, shared with drivers outside Vulkan. Sizes are
+ * not overflow-checked; callers bound code_size for untrusted input.
+ */
+static inline uint32_t
+nak_min_cbuf_alignment(const struct nv_device_info *info)
+{
+   return info->cls_eng3d >= TURING_A ? 64 : 256;
+}
+
+static inline uint32_t
+nak_shader_get_hdr_size(const struct nv_device_info *info,
+                        const struct nak_shader_info *shader_info)
+{
+   if (shader_info->stage == MESA_SHADER_COMPUTE)
+      return 0;
+
+   return info->cls_eng3d >= TURING_A ? TU102_SHADER_HEADER_SIZE
+                                      : GF100_SHADER_HEADER_SIZE;
+}
+
+static inline uint32_t
+nak_shader_get_shader_alignment(const struct nv_device_info *info)
+{
+   /* Fermi   needs 0x40 alignment
+    * Kepler+ needs the first instruction to be 0x80 aligned, so we waste 0x30 bytes
+    */
+   return info->cls_eng3d >= KEPLER_A ? 0x80 : 0x40;
+}
+
+static inline uint32_t
+nak_shader_get_shader_size(const struct nv_device_info *info,
+                           const struct nak_shader_info *shader_info,
+                           uint32_t code_size, uint32_t *out_hdr_offset,
+                           uint32_t *out_code_offset, uint32_t *out_gs_hdr_offset)
+{
+   const uint32_t hdr_size = nak_shader_get_hdr_size(info, shader_info);
+   const uint32_t alignment = nak_shader_get_shader_alignment(info);
+
+   uint32_t total_size = 0;
+   if (info->cls_eng3d >= KEPLER_A &&
+       info->cls_eng3d < TURING_A &&
+       hdr_size > 0) {
+      /* The instructions are what has to be aligned so we need to start at a
+       * small offset (0x30 B) into the upload area.
+       */
+      total_size = alignment - hdr_size;
+   }
+
+   if (out_hdr_offset)
+      *out_hdr_offset = total_size;
+
+   total_size += hdr_size;
+
+   if (out_code_offset) {
+      *out_code_offset = total_size;
+      assert(*out_code_offset % alignment == 0);
+   }
+
+   total_size += code_size;
+
+   const bool has_mesh_gs_sph = shader_info->stage == MESA_SHADER_MESH &&
+                                shader_info->mesh.has_gs_sph;
+
+   if (out_gs_hdr_offset)
+      *out_gs_hdr_offset = 0;
+   if (has_mesh_gs_sph) {
+      total_size = align(total_size, nak_min_cbuf_alignment(info));
+      if (out_gs_hdr_offset)
+         *out_gs_hdr_offset = total_size;
+      total_size += hdr_size;
+   }
+
+   return total_size;
+}
+
+#endif
