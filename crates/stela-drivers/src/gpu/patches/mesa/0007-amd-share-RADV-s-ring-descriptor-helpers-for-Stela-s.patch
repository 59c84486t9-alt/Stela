           'nir/ac_nir_lower_global_access.c', 'nir/ac_nir_lower_intrinsics_to_args.c',
           'nir/ac_nir_opt_shared_append.c') +
       [gfx10_format_table_c] +
diff --git a/src/amd/common/nir/ac_nir.h b/src/amd/common/nir/ac_nir.h
index 14bbd6b..94865ce 100644
--- a/src/amd/common/nir/ac_nir.h
+++ b/src/amd/common/nir/ac_nir.h
@@ -76,6 +76,14 @@ ac_nir_load_arg_at_offset(nir_builder *b, const struct ac_shader_args *ac_args,
 nir_def *
 ac_nir_load_arg(nir_builder *b, const struct ac_shader_args *ac_args, struct ac_arg arg);
 
+/* Original ring/attribute descriptor operations. Caller supplies the actual
+ * architectural argument, real ring-table slot and linked parameter counts;
+ * no GPU address/allocation or stage selection is invented by these helpers. */
+nir_def *ac_nir_load_ring_descriptor(nir_builder *b, const struct ac_shader_args *args,
+                                   struct ac_arg arg, unsigned ring);
+nir_def *ac_nir_apply_attribute_ring_stride(nir_builder *b, nir_def *descriptor,
+                                          unsigned param_exports, unsigned prim_param_exports);
+
 nir_def *
 ac_nir_load_arg_upper_bound(nir_builder *b, const struct ac_shader_args *ac_args, struct ac_arg arg,
                             unsigned upper_bound);
diff --git a/src/amd/common/nir/ac_nir_abi.c b/src/amd/common/nir/ac_nir_abi.c
new file mode 100644
index 0000000..db8a0be
--- /dev/null
+++ b/src/amd/common/nir/ac_nir_abi.c
@@ -0,0 +1,32 @@
+/*
+ * Copyright © 2022 Valve Corporation
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#include "ac_nir.h"
+#include "amdgfxregs.h"
+#include "nir_builder.h"
+
+/* Original RADV ring descriptor body. Resource ownership and architectural
+ * argument/ring selection stay with the real calling stage/driver. */
+nir_def *
+ac_nir_load_ring_descriptor(nir_builder *b, const struct ac_shader_args *args, struct ac_arg arg,
+                            unsigned ring)
+{
+   nir_def *ring_offsets = ac_nir_load_arg(b, args, arg);
+   ring_offsets = nir_pack_64_2x32_split(b, nir_channel(b, ring_offsets, 0), nir_channel(b, ring_offsets, 1));
+   return ac_nir_load_smem(b, 4, ring_offsets, nir_imm_int(b, ring * 16u), 4, ACCESS_CAN_SPECULATE);
+}
+
+nir_def *
+ac_nir_apply_attribute_ring_stride(nir_builder *b, nir_def *descriptor, unsigned param_exports,
+                                   unsigned prim_param_exports)
+{
+   /* Note, the HW always assumes there is at least 1 per-vertex param. */
+   const unsigned total_num_params = MAX2(1, param_exports) + prim_param_exports;
+
+   nir_def *dword1 = nir_channel(b, descriptor, 1);
+   dword1 = nir_ior_imm(b, dword1, S_008F04_STRIDE(16 * total_num_params));
+   descriptor = nir_vector_insert_imm(b, descriptor, dword1, 1);
+   return descriptor;
+}
diff --git a/src/amd/vulkan/nir/radv_nir_lower_abi.c b/src/amd/vulkan/nir/radv_nir_lower_abi.c
index 382cab6..c09e0bb 100644
