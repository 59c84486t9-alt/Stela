@@ -239,7 +240,7 @@ if with_stela_amd
     'amd_compiler_support',
     files('ac_compiler_info.c', 'ac_shader_args.c', 'ac_shader_util.c', 'amd_family.c',
           'ac_gpu_info_compute.c', 'ac_binary.c',
-          'ac_descriptors.c', 'ac_formats.c', 'nir/ac_nir.c',
