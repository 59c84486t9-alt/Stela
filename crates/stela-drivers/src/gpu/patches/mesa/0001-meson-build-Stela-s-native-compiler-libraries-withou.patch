From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tyler Smith <74526874+tylertms@users.noreply.github.com>
Date: Thu, 22 Oct 2026 00:00:00 +0000
Subject: [PATCH] meson: build Stela's native compiler libraries without API
 frontends

---
 meson.build                         | 43 +++++++++++++++++++++++++----
 meson.options                       | 25 +++++++++++++++++
 src/amd/meson.build                 |  2 +-
 src/compiler/meson.build            |  6 ++--
 src/meson.build                     | 29 ++++++++++---------
 src/nouveau/compiler/meson.build    | 14 ++++++++--
 src/nouveau/compiler/nak_bindings.h |  2 ++
 src/nouveau/headers/meson.build     |  6 +++-
 src/nouveau/meson.build             |  8 ++++--
 9 files changed, 105 insertions(+), 30 deletions(-)

diff --git a/meson.build b/meson.build
index a864ed0b23cdb0c4853e68432cdfdb6fcdd519c2..95ef033b486eb8cbf8ca0f9daf11371471baca81 100644
--- a/meson.build
+++ b/meson.build
@@ -39,6 +39,16 @@ sizeof_pointer = cc.sizeof('void*').to_string()
 
 null_dep = dependency('', required : false)
 
+stela_compilers = get_option('stela-compilers')
+with_stela_nvidia = stela_compilers.contains('nvidia')
+with_stela_amd = stela_compilers.contains('amd')
+with_stela_intel = stela_compilers.contains('intel')
+with_stela_compilers = stela_compilers.length() > 0
+with_stela_amd_llvm = get_option('stela-amd-llvm')
+if with_stela_amd_llvm and not with_stela_amd
+  error('stela-amd-llvm requires the amd Stela compiler target')
+endif
+
 if get_option('layout') != 'mirror'
   error('`mirror` is the only build directory layout supported')
 endif
@@ -53,8 +63,9 @@ if get_option('b_lto')
   endif
 endif
 
-with_llvm = get_option('llvm')
-amd_with_llvm = with_llvm.allowed() and get_option('amd-use-llvm')
+with_llvm = get_option('llvm').enable_if(with_stela_amd_llvm,
+  error_message : 'The Stela AMD LLVM backend requires LLVM')
+amd_with_llvm = with_llvm.allowed() and (get_option('amd-use-llvm') or with_stela_amd_llvm)
 
 with_mesa_debug = get_option('buildtype') == 'debug'
 
@@ -158,6 +169,9 @@ pre_args += '-DHAVE_OPENGL_ES_1=@0@'.format(with_gles1.to_int())
 pre_args += '-DHAVE_OPENGL_ES_2=@0@'.format(with_gles2.to_int())
 
 with_any_opengl = with_opengl or with_gles1 or with_gles2
+if with_any_opengl
+  error('This Stela fork excludes the OpenGL frontend. Disable opengl, gles1 and gles2.')
+endif
 
 system_has_kms_drm = ['openbsd', 'netbsd', 'freebsd', 'gnu/kfreebsd', 'dragonfly', 'linux', 'sunos', 'android', 'managarm'].contains(host_machine.system())
 
@@ -382,6 +396,7 @@ with_intel_vk_rt = get_option('intel-rt') \
   .allowed()
 
 with_any_intel = [
+  with_stela_intel,
   with_gallium_crocus,
   with_gallium_i915,
   with_gallium_iris,
@@ -389,7 +404,7 @@ with_any_intel = [
   with_intel_tools,
   with_intel_vk,
 ].contains(true)
-with_any_nouveau = with_gallium_nouveau or with_nouveau_vk
+with_any_nouveau = with_gallium_nouveau or with_nouveau_vk or with_stela_nvidia
 
 # needed in the loader
 if with_nouveau_vk
@@ -863,7 +878,7 @@ if with_gallium_rusticl
 endif
 
 with_virtgpu_kumquat = get_option('virtgpu_kumquat') and with_gfxstream_vk
-if with_gallium_rusticl or with_nouveau_vk or with_tools.contains('etnaviv') or with_virtgpu_kumquat or with_panfrost_rust
+if with_gallium_rusticl or with_nouveau_vk or with_tools.contains('etnaviv') or with_virtgpu_kumquat or with_panfrost_rust or with_stela_nvidia
   # rust.bindgen() does not pass `--rust-target` to bindgen until 1.7.0.
   if meson.version().version_compare('< 1.7.0')
     error('Mesa Rust support requires Meson 1.7.0 or newer')
@@ -993,6 +1008,7 @@ if with_gallium_rusticl or with_microsoft_clc
 endif
 
 with_gfx_compute = [
+  with_stela_compilers,
   with_any_opengl,
   with_any_vk,
   with_clc,
@@ -1954,6 +1970,20 @@ foreach d : _libdrm_checks
   endif
 endforeach
 
+# Stela's AMD compilers use libdrm's types but never call it, and libdrm does
+# not build on every host, so they take its headers alone from Mesa's wrap.
+if with_stela_amd and not dep_libdrm_amdgpu.found()
+  _libdrm_headers = 'subprojects/libdrm-2.4.133'
+  dep_libdrm_amdgpu = declare_dependency(
+    include_directories : include_directories(
+      _libdrm_headers, _libdrm_headers / 'include/drm', _libdrm_headers / 'amdgpu'),
+  )
+endif
+# Addrlib's Apple path needs Apple's private headers; use its public one.
+if with_stela_amd and host_machine.system() == 'darwin'
+  pre_args += '-DHAVE_TSERVER'
+endif
+
 dep_libudev = dependency('libudev', required : false)
 if dep_libudev.found()
   pre_args += '-DHAVE_LIBUDEV'
@@ -1961,7 +1991,7 @@ endif
 
 llvm_modules = ['bitwriter', 'engine', 'mcdisassembler', 'mcjit', 'core', 'executionengine', 'scalaropts', 'transformutils', 'instcombine']
 llvm_optional_modules = ['coroutines']
-if with_amd_vk or with_gallium_radeonsi
+if with_amd_vk or with_gallium_radeonsi or with_stela_amd_llvm
   llvm_modules += ['amdgpu', 'bitreader', 'ipo']
 endif
 if with_clc
@@ -2013,6 +2043,9 @@ dep_llvm = dependency(
   include_type : 'system',
 )
 if dep_llvm.found()
+  if with_stela_amd_llvm and not (dep_llvm.version().version_compare('>=23.0') and dep_llvm.version().version_compare('<24.0'))
+    error('The Stela AMD LLVM backend currently requires LLVM 23')
+  endif
   pre_args += '-DMESA_LLVM_VERSION_STRING="@0@"'.format(dep_llvm.version())
   pre_args += '-DLLVM_IS_SHARED=@0@'.format(_shared_llvm.to_int())
 
diff --git a/meson.options b/meson.options
index 93a60e3047b91efb89394fddacacf927009f26d6..c61b031529ac22c289dd49710510ad15f33abff4 100644
--- a/meson.options
+++ b/meson.options
@@ -915,3 +915,28 @@ option(
   value : false,
   description : 'Build panfrost Rust components.'
 )
+option(
+  'stela-compilers',
+  type : 'array',
+  choices : ['nvidia', 'amd', 'intel'],
+  value : [],
+  description : 'Build native shader compiler libraries without graphics API frontends or device I/O',
+)
+option(
+  'stela-air-llvm-library',
+  type : 'string',
+  value : '',
+  description : 'Absolute LLVM 23 shared-library path for the optional native AIR compiler; empty disables it',
+)
+option(
+  'stela-amd-llvm',
+  type : 'boolean',
+  value : false,
+  description : 'Build the retained AMD LLVM backend for Stela compiler targets (requires matching LLVM 23 development files)',
+)
+option(
+  'stela-metal-input-library',
+  type : 'string',
+  value : '',
+  description : 'Matching hosted Rust input static library for the optional Darwin Metal library assembler',
+)
diff --git a/src/amd/meson.build b/src/amd/meson.build
index 92fe3d19053aedd0513ad762c7adf14cfbd39983..175e113905831eb006820edd5be696d238b7b778 100644
--- a/src/amd/meson.build
+++ b/src/amd/meson.build
@@ -7,7 +7,7 @@ if with_tools.contains('drm-shim')
   subdir('drm-shim')
 endif
 
-if with_amd_vk or with_gallium_radeonsi
+if with_amd_vk or with_gallium_radeonsi or with_stela_amd
   subdir('addrlib')
   subdir('common')
   if amd_with_llvm
diff --git a/src/compiler/meson.build b/src/compiler/meson.build
index 68f083273dfbbb1739b6d1c131b7606e8b6f3878..34728fe6225915a3be2ecd2fdf502ab626e09a07 100644
--- a/src/compiler/meson.build
+++ b/src/compiler/meson.build
@@ -68,11 +68,9 @@ subdir('spirv')
 if with_clc
   subdir('clc')
 endif
-if with_gallium
-  subdir('glsl')
-endif
+# The shared type/operation generators remain; the GLSL API frontend is removed.
 subdir('isaspec')
 
-if with_nouveau_vk or with_tools.contains('etnaviv') or with_panfrost_rust
+if with_nouveau_vk or with_tools.contains('etnaviv') or with_panfrost_rust or with_stela_nvidia
   subdir('rust')
 endif
diff --git a/src/meson.build b/src/meson.build
index c36f44b1397846860b3101f4512c44a0158ce4fa..420551f2fd94d5759eb09b9c4d0bae158ade82e3 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -8,22 +8,27 @@ mesa_python_path = [
 
 subdir('gtest')
 subdir('c11/impl')
-subdir('android_stub')
+if with_platform_android
+  subdir('android_stub')
+endif
 subdir('util')
 
-inc_mesa = include_directories('mesa')
+# The OpenGL core and state tracker have been removed from this driver fork.
+inc_mesa = []
 inc_src = include_directories('.')
 inc_gallium = include_directories('gallium/include')
 inc_gallium_aux = include_directories('gallium/auxiliary')
 inc_amd_common = include_directories('amd/common', 'amd/common/nir')
 inc_tool = include_directories('tool')
-inc_virtio = include_directories('virtio')
-inc_virtio_gpu = include_directories('virtio/virtio-gpu')
-inc_frontends = include_directories('gallium/frontends')
+# This fork retains the native GPU compiler backends. Deleted virtual GPU
+# and API frontends are not dependencies of those compilers.
+inc_virtio = []
+inc_virtio_gpu = []
+inc_frontends = []
 pps_datasources = []
 pps_includes = []
 
-inc_llvmpipe = include_directories('gallium/drivers/llvmpipe')
+inc_llvmpipe = []
 
 if dep_llvm.found()
   inc_amd_common_llvm = include_directories('amd/llvm')
@@ -35,12 +40,7 @@ inc_radv_bvh = include_directories('amd/vulkan/bvh')
 inc_radv_tools = include_directories('amd/vulkan/tools')
 inc_vulkan_bvh = include_directories('vulkan/runtime/bvh')
 
-glsl_util_files = files(
-    'mesa/main/extensions_table.c',
-    'mesa/program/prog_parameter.c',
-    'mesa/program/symbol_table.c',
-    'mesa/program/dummy_errors.c',
-)
+glsl_util_files = []
 
 sha1_h = custom_target(
   'git_sha1.h',
@@ -83,7 +83,7 @@ endif
 if with_vdrm
   subdir('virtio/vdrm')
 endif
-if with_gallium_radeonsi or with_amd_vk or with_gallium_r300 or with_gallium_r600
+if with_gallium_radeonsi or with_amd_vk or with_gallium_r300 or with_gallium_r600 or with_stela_amd
   subdir('amd')
 endif
 if with_any_broadcom
@@ -110,6 +110,9 @@ endif
 if with_any_nouveau
   subdir('nouveau')
 endif
+if with_stela_compilers
+  subdir('stela')
+endif
 if with_gfxstream_vk
   dep_virtgpu_kumquat_ffi = null_dep
   if with_virtgpu_kumquat
diff --git a/src/nouveau/compiler/meson.build b/src/nouveau/compiler/meson.build
index df192993e9e33e6cef9120aed38f46917771c367..6b294bed6fd119ecaa82f3e682bf45cef5812bb1 100644
--- a/src/nouveau/compiler/meson.build
+++ b/src/nouveau/compiler/meson.build
@@ -40,11 +40,20 @@ libnak_deps = [
   idep_nil_h,
 ]
 
+nak_bindgen_args = []
+nak_platform_deps = []
+if with_stela_nvidia
+  nak_bindgen_args += '-DSTELA_COMPILERS'
+else
+  nak_platform_deps += [dep_libdrm, idep_nouveau_ws]
+endif
+
 _nak_bindings_rs = rust.bindgen(
   input : ['nak_bindings.h'],
   output : 'nak_bindings.rs',
   c_args : [
     pre_args,
+    nak_bindgen_args,
   ],
   args : [
     bindgen_output_args,
@@ -66,8 +75,7 @@ _nak_bindings_rs = rust.bindgen(
     '--with-derive-default',
   ],
   dependencies : [
-    dep_libdrm,
-    idep_nouveau_ws,
+    nak_platform_deps,
     libnak_deps,
   ],
 )
@@ -119,7 +127,7 @@ _libnak_rs = static_library(
 #
 # Also, don't build on Android because we do cross-builds and, unlike most
 # tests, these depend on libdrm and that confuses the build system.
-if with_tests and get_option('b_sanitize') == 'none' and not with_platform_android
+if with_tests and get_option('b_sanitize') == 'none' and not with_platform_android and not with_stela_nvidia
   rust.test(
     'nak',
     _libnak_rs,
diff --git a/src/nouveau/compiler/nak_bindings.h b/src/nouveau/compiler/nak_bindings.h
index e766da19f9872923fe845de07d9648199856a29f..e3ffa21e0c2c72170b974a1164153b4a521f5907 100644
--- a/src/nouveau/compiler/nak_bindings.h
+++ b/src/nouveau/compiler/nak_bindings.h
@@ -5,6 +5,7 @@
 
 #include "nak_private.h"
 
+#ifndef STELA_COMPILERS
 #include "nouveau_bo.h"
 #include "nouveau_context.h"
 #include "nouveau_device.h"
@@ -18,3 +19,4 @@
 enum ENUM_PACKED drm_rs_ioctls {
    DRM_RS_IOCTL(NOUVEAU_EXEC),
 };
+#endif
diff --git a/src/nouveau/headers/meson.build b/src/nouveau/headers/meson.build
index b3a0273874659ac618f4efeb634f08c2e4b91126..dd11fb2974e56540b39e9512b69a84950c797f1c 100644
--- a/src/nouveau/headers/meson.build
+++ b/src/nouveau/headers/meson.build
@@ -76,6 +76,7 @@ hwref_gens = [
 flat_nv_classes = ''
 
 cl_generated = []
+stela_nv_compute_headers = []
 foreach cl : nv_classes
   prev_cl_h = []
   prev_cl_args = []
@@ -98,6 +99,9 @@ foreach cl : nv_classes
     command : [prog_python, '@INPUT0@', '--in-h', '@INPUT1@', prev_cl_args,
                '--out-h', '@OUTPUT0@', '--out-c', '@OUTPUT1@'],
   )
+  if ['cla0c0', 'clc6c0'].contains(cl)
+    stela_nv_compute_headers += [cl_generated[-1][0]]
+  endif
 endforeach
 
 nv_push_class_dump_h = custom_target(
@@ -133,7 +137,7 @@ nouveau_util_py = files('util.py')
 nouveau_util_py_path = meson.current_source_dir()
 
 # Only generate Rust bindings for NVK
-if with_nouveau_vk
+if with_nouveau_vk or with_stela_nvidia
   cl_rs_generated = []
   foreach cl : nv_classes
     cl_rs_generated += custom_target(
diff --git a/src/nouveau/meson.build b/src/nouveau/meson.build
index de6d45806b727781a2b855f82c06c9a1545f1279..b971fde3c5ce51e41a9da073021b43731a7f4242 100644
--- a/src/nouveau/meson.build
+++ b/src/nouveau/meson.build
@@ -2,9 +2,11 @@
 # SPDX-License-Identifier: MIT
 
 subdir('headers')
-subdir('drm')
-subdir('winsys')
-if with_nouveau_vk
+if not with_stela_nvidia
+  subdir('drm')
+  subdir('winsys')
+endif
+if with_nouveau_vk or with_stela_nvidia
   subdir('rust')
   subdir('nil')
   subdir('compiler')
