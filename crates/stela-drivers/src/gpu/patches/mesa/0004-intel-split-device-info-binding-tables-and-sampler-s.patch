index 0000000000000000000000000000000000000000..1eb6ad36951f8d78e1ea1403bbdb740209f9a20b
--- /dev/null
+++ b/src/intel/dev/intel_device_info_topology.c
@@ -0,0 +1,131 @@
+/*
