[submodule "linux"]
	path = third_party/linux
	url = https://github.com/gregkh/linux.git
	shallow = true
[submodule "mesa"]
	path = third_party/mesa
	url = https://gitlab.freedesktop.org/mesa/mesa.git
	shallow = true
[submodule "nvidia"]
	path = third_party/nvidia
	url = https://github.com/NVIDIA/open-gpu-kernel-modules.git
	shallow = true
[submodule "llvm"]
	path = third_party/llvm
	url = https://github.com/llvm/llvm-project.git
	shallow = true
[submodule "libdrm"]
	path = third_party/libdrm
	url = https://gitlab.freedesktop.org/mesa/drm.git
	shallow = true
[submodule "venus-protocol"]
	path = third_party/venus-protocol
	url = https://gitlab.freedesktop.org/virgl/venus-protocol.git
	shallow = true
[submodule "virglrenderer"]
	path = third_party/virglrenderer
	url = https://gitlab.freedesktop.org/virgl/virglrenderer.git
	shallow = true
