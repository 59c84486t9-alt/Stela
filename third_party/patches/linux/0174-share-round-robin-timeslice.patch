From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tyler Smith <74526874+tylertms@users.noreply.github.com>
Date: Wed, 4 Nov 2026 04:17:50 -0500
Subject: [PATCH] refactor(sched): share original round-robin time slice

---
 kernel/sched/Makefile          | 2 +-
 kernel/sched/fork_load.c       | 3 +--
 kernel/sched/fork_sources.json | 7 ++++++-
 kernel/sched/rt.c              | 1 -
 kernel/sched/rt_timeslice.c    | 6 ++++++
 5 files changed, 14 insertions(+), 5 deletions(-)
 create mode 100644 kernel/sched/rt_timeslice.c

diff --git a/kernel/sched/Makefile b/kernel/sched/Makefile
index dbac21902aab670182ae300f75787b039d3d2aea..8165228b7af36ba608245419cbfdf06a568bc35a 100644
--- a/kernel/sched/Makefile
+++ b/kernel/sched/Makefile
@@ -41,5 +41,5 @@ endif
 #
 obj-y += core.o wait_support.o user_affinity.o
 obj-y += fair.o
-obj-y += build_policy.o cputime_group.o
+obj-y += build_policy.o cputime_group.o rt_timeslice.o
 obj-y += build_utility.o capacity_state.o
diff --git a/kernel/sched/fork_load.c b/kernel/sched/fork_load.c
index f2f565235d5804d9629608a0075ea974d792a42d..b82750521196c0d530de110aabe63a671fafd8f9 100644
--- a/kernel/sched/fork_load.c
+++ b/kernel/sched/fork_load.c
@@ -15,7 +15,7 @@
  * Adaptive scheduling granularity, math enhancements by Peter Zijlstra
  * Copyright (C) 2007 Red Hat, Inc., Peter Zijlstra
  */
-/* Task-local metadata extracted from original core.c/fair.c/rt.c.
+/* Task-local metadata extracted from original core.c and fair.c.
  * Original source authors/licensing remain as recorded in fork_sources.json.
  * No CFS/RT runqueue, capacity topology, timer callback or class identity is
  * manufactured. Duplicate original definitions must not also be linked.
@@ -66,7 +66,6 @@ const u32 sched_prio_to_wmult[40] = {
  /*  15 */ 119304647, 148102320, 186737708, 238609294, 286331153,
 };
 
-int sched_rr_timeslice = RR_TIMESLICE;
 unsigned int sysctl_sched_base_slice			= 700000ULL;
 
 void stela_linux_sched_load_weight(struct task_struct *p)
diff --git a/kernel/sched/fork_sources.json b/kernel/sched/fork_sources.json
index 90ac93ebb766015acd19fb6c176121d9b13a987e..e62b3c1583d4ddfafd9c54f5b156bf813c334948 100644
--- a/kernel/sched/fork_sources.json
+++ b/kernel/sched/fork_sources.json
@@ -132,12 +132,16 @@
     },
     {
       "path": "kernel/sched/fork_load.c",
-      "sha256": "652136e639f33e738def11694bb9ddab015c9ed12ec0c41ef5c357f4bec0a782"
+      "sha256": "795d690aa482487befd2c016b43f591a529d9811066cc43d48045702b4e86f5a"
     },
     {
       "path": "kernel/sched/fork_metadata.c",
       "sha256": "75d4b690e902c000033939baac67f12867049deca430db4c4a85b0b200bdb184"
     },
+    {
+      "path": "kernel/sched/rt_timeslice.c",
+      "sha256": "381e0d09ddb4c941a6d9b9aa2dea214299a99c07e5a7199aaabd58b79fa40d3d"
+    },
     {
       "path": "kernel/sched/fork_support.c",
       "sha256": "05d7a95728b383c3efa8e0a7ac409c2106560264c2443f8d85f7f09b4e863fb6"
@@ -147,6 +151,7 @@
     "set_load_weight is specialized for update_load=false and named stela_linux_sched_load_weight; no CFS runqueue reweighting is implemented.",
     "Task-local weights, slice defaults, and average initialization are built separately from the original asymmetric-capacity helper. The native 64-bit non-group branch uses the matching original sched.h scaling and entity rules.",
     "set_task_max_allowed_capacity is named stela_linux_sched_fork_fair_capacity; it reads the original capacity/static-key definitions moved from topology.c into capacity_state.c. The native and regular scheduler paths share the original declarations and static-key query in fork_capacity.h.",
+    "The original sched_rr_timeslice definition is shared by the regular and native scheduler builds through rt_timeslice.c.",
     "Original sched_fork class and placement decisions require the native admit/select/place operations declared in fork_backend.h.",
     "Disabled SCHED_CACHE, UCLAMP_TASK and SCHED_MM_CID branches remain guarded by their original configuration conditions.",
     "This manifest records source provenance only; it does not establish compilation, linking, execution or native admission."
diff --git a/kernel/sched/rt.c b/kernel/sched/rt.c
index 85303add726df4c2da846c427aab2d627fca9589..9db8c4a051de65751c95291e394b96d740f1995d 100644
--- a/kernel/sched/rt.c
+++ b/kernel/sched/rt.c
@@ -7,7 +7,6 @@
 #include "sched.h"
 #include "pelt.h"
 
-int sched_rr_timeslice = RR_TIMESLICE;
 /* More than 4 hours if BW_SHIFT equals 20. */
 static const u64 max_rt_runtime = MAX_BW;
 
diff --git a/kernel/sched/rt_timeslice.c b/kernel/sched/rt_timeslice.c
new file mode 100644
index 0000000000000000000000000000000000000000..1396ffa26ab93da4103a6b0ed8342a119bc9dc76
--- /dev/null
+++ b/kernel/sched/rt_timeslice.c
@@ -0,0 +1,6 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Original round-robin time slice from kernel/sched/rt.c. */
+#include <linux/sched/rt.h>
+#include <linux/jiffies.h>
+
+int sched_rr_timeslice = RR_TIMESLICE;
