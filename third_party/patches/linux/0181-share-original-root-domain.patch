diff --git a/kernel/sched/sched_ratio.c b/kernel/sched/sched_ratio.c
index ff6c137eb4928c7e2b7e4abf8c431726acb50a26..25b92b924d6b8c41315eb9aca6ba7a8cccef6887 100644
