index 0000000000000000000000000000000000000000..c3fb4af2479eb692f7fa1ebbcb97ed7956fa52f2
--- /dev/null
+++ b/fs/mount_init.c
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ *  linux/fs/namespace.c
