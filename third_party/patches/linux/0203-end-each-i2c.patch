From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tyler Smith <74526874+tylertms@users.noreply.github.com>
Date: Sat, 14 Nov 2026 18:00:00 +0000
Subject: [PATCH] fix(nouveau): end each I2C read over a GSP-RM DisplayPort AUX
 channel with MOT cleared and send no address-only transfer, as NVIDIA's
 DisplayPort library reads EDID

---
 drivers/gpu/drm/nouveau/nouveau_connector.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/nouveau/nouveau_connector.c b/drivers/gpu/drm/nouveau/nouveau_connector.c
index 4cfc9c7c2ae0c77c64e7efe27d7927999e2a36dd..916a56ff16bebba21eb88d92d12351ee1c9428e4 100644
--- a/drivers/gpu/drm/nouveau/nouveau_connector.c
+++ b/drivers/gpu/drm/nouveau/nouveau_connector.c
@@ -49,6 +49,8 @@
 #include <nvif/class.h>
 #include <nvif/if0011.h>
 
+#include <subdev/gsp.h>
+
 struct drm_display_mode *
 nouveau_conn_native_mode(struct drm_connector *connector)
 {
@@ -1407,7 +1409,18 @@ nouveau_connector_create(struct drm_device *dev, int index)
 		nv_connector->aux.drm_dev = dev;
 		nv_connector->aux.transfer = nouveau_connector_aux_xfer;
 		nv_connector->aux.name = connector->name;
-		if (disp->disp.object.oclass >= GB202_DISP)
+		/*
+		 * GSP-RM's DP_AUXCH_CTRL sends an address-only request only as
+		 * an I2C write with MOT=0 (r535_dp_aux_xfer), so drm's bare
+		 * address that ends an I2C read reaches the sink as a write
+		 * start/stop and the read is never ended with MOT=0. A sink
+		 * then answers the next EDID read from another offset. Without
+		 * zero-sized transfers the last chunk of each message ends it
+		 * instead, as NVIDIA's own DisplayPort library reads EDID
+		 * through the same control.
+		 */
+		if (disp->disp.object.oclass >= GB202_DISP ||
+		    nvkm_gsp_rm(nvxx_device(drm)->gsp))
 			nv_connector->aux.no_zero_sized = true;
 		drm_dp_aux_init(&nv_connector->aux);
 		break;
