-static int max_threads;		/* tunable limit on nr_threads */
-
 #define NAMED_ARRAY_INDEX(x)	[x] = __stringify(x)
 
 static const char * const resident_page_types[] = {
@@ -182,8 +170,6 @@ void __weak arch_release_task_struct(struct task_struct *tsk)
 {
 }
 
-static struct kmem_cache *task_struct_cachep;
-
 static inline struct task_struct *alloc_task_struct_node(int node)
 {
 	return kmem_cache_alloc_node(task_struct_cachep, GFP_KERNEL, node);
@@ -292,7 +278,7 @@ static void thread_stack_delayed_free(struct task_struct *tsk)
 	call_rcu(&vm_stack->rcu, thread_stack_free_rcu);
 }
 
-static int free_vm_stack_cache(unsigned int cpu)
+int free_vm_stack_cache(unsigned int cpu)
 {
 	struct vm_struct **cached_vm_stack_areas = per_cpu_ptr(cached_stacks, cpu);
 	int i;
@@ -794,97 +780,6 @@ void __put_task_struct_rcu_cb(struct rcu_head *rhp)
 }
 EXPORT_SYMBOL_GPL(__put_task_struct_rcu_cb);
 
