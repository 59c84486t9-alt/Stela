 #ifdef CONFIG_DEBUG_FS
 static DEFINE_PER_CPU(long, mg_ctime_updates);
 static DEFINE_PER_CPU(long, mg_fine_stamps);
@@ -158,147 +123,6 @@ late_initcall(mg_debugfs_init);
 
 #endif /* CONFIG_DEBUG_FS */
 
