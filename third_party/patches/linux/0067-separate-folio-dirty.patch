 /*
  * Helper function for set_page_dirty family.
  *
@@ -2692,65 +2681,6 @@ bool folio_redirty_for_writepage(struct writeback_control *wbc,
 }
 EXPORT_SYMBOL(folio_redirty_for_writepage);
 
