From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tyler Smith <74526874+tylertms@users.noreply.github.com>
Date: Mon, 2 Nov 2026 23:00:36 -0500
Subject: [PATCH] refactor(mm): separate original page cache initialization

---
 mm/Makefile         |  2 +-
 mm/filemap.c        | 39 +--------------------------------------
 mm/pagecache_init.c | 40 ++++++++++++++++++++++++++++++++++++++++
 mm/pagecache_wait.h | 22 ++++++++++++++++++++++
 4 files changed, 64 insertions(+), 39 deletions(-)
 create mode 100644 mm/pagecache_init.c
 create mode 100644 mm/pagecache_wait.h

diff --git a/mm/Makefile b/mm/Makefile
index 92c998a845b128c9c41fec6f2aa68083eb7522f1..9ecb5fa359f6eb7ddfbde3aec9f99ef744b9fa8a 100644
--- a/mm/Makefile
+++ b/mm/Makefile
@@ -48,7 +48,7 @@ ifdef CONFIG_64BIT
 mmu-$(CONFIG_MMU)	+= mseal.o
 endif
 
-obj-y			:= filemap.o mempool.o oom_kill.o fadvise.o \
+obj-y			:= filemap.o pagecache_init.o mempool.o oom_kill.o fadvise.o \
 			   maccess.o page-writeback.o folio-compat.o \
 			   readahead.o swap.o truncate.o vmscan.o shrinker.o \
 			   shmem.o util.o mmzone.o vmstat.o vmstat_init.o backing-dev.o \
diff --git a/mm/filemap.c b/mm/filemap.c
index ebc51fabfcd8d28b6cd75c220ae3b174d947932e..d79941026b1b7d4415ebed2d63db214dca1f8d9e 100644
--- a/mm/filemap.c
+++ b/mm/filemap.c
@@ -52,6 +52,7 @@
 
 #include <asm/tlbflush.h>
 #include "internal.h"
+#include "pagecache_wait.h"
 
 #define CREATE_TRACE_POINTS
 #include <trace/events/filemap.h>
@@ -1059,49 +1060,11 @@ void filemap_invalidate_unlock_two(struct address_space *mapping1,
 }
 EXPORT_SYMBOL(filemap_invalidate_unlock_two);
 
-/*
- * In order to wait for pages to become available there must be
- * waitqueues associated with pages. By using a hash table of
- * waitqueues where the bucket discipline is to maintain all
- * waiters on the same queue and wake all when any of the pages
- * become available, and for the woken contexts to check to be
- * sure the appropriate page became available, this saves space
- * at a cost of "thundering herd" phenomena during rare hash
- * collisions.
- */
-#define PAGE_WAIT_TABLE_BITS 8
-#define PAGE_WAIT_TABLE_SIZE (1 << PAGE_WAIT_TABLE_BITS)
-static wait_queue_head_t folio_wait_table[PAGE_WAIT_TABLE_SIZE] __cacheline_aligned;
-
 static wait_queue_head_t *folio_waitqueue(struct folio *folio)
 {
 	return &folio_wait_table[hash_ptr(folio, PAGE_WAIT_TABLE_BITS)];
 }
 
-/* How many times do we accept lock stealing from under a waiter? */
-static int sysctl_page_lock_unfairness = 5;
-static const struct ctl_table filemap_sysctl_table[] = {
-	{
-		.procname	= "page_lock_unfairness",
-		.data		= &sysctl_page_lock_unfairness,
-		.maxlen		= sizeof(sysctl_page_lock_unfairness),
-		.mode		= 0644,
-		.proc_handler	= proc_dointvec_minmax,
-		.extra1		= SYSCTL_ZERO,
-	}
-};
-
-void __init pagecache_init(void)
-{
-	int i;
-
-	for (i = 0; i < PAGE_WAIT_TABLE_SIZE; i++)
-		init_waitqueue_head(&folio_wait_table[i]);
-
-	page_writeback_init();
-	register_sysctl_init("vm", filemap_sysctl_table);
-}
-
 /*
  * The page wait code treats the "wait->flags" somewhat unusually, because
  * we have multiple different kinds of waits, not just the usual "exclusive"
diff --git a/mm/pagecache_init.c b/mm/pagecache_init.c
new file mode 100644
index 0000000000000000000000000000000000000000..96377bb189d9231da52f4ac8beff3f73b0eef198
--- /dev/null
+++ b/mm/pagecache_init.c
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ *	linux/mm/filemap.c
+ *
+ * Copyright (C) 1994-1999  Linus Torvalds
+ */
+
+#include <linux/init.h>
+#include <linux/pagemap.h>
+#include <linux/sysctl.h>
+#include <linux/writeback.h>
+
+#include "internal.h"
+#include "pagecache_wait.h"
+
+wait_queue_head_t folio_wait_table[PAGE_WAIT_TABLE_SIZE] __cacheline_aligned;
+
+/* How many times do we accept lock stealing from under a waiter? */
+int sysctl_page_lock_unfairness = 5;
+static const struct ctl_table filemap_sysctl_table[] = {
+	{
+		.procname	= "page_lock_unfairness",
+		.data		= &sysctl_page_lock_unfairness,
+		.maxlen		= sizeof(sysctl_page_lock_unfairness),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= SYSCTL_ZERO,
+	}
+};
+
+void __init pagecache_init(void)
+{
+	int i;
+
+	for (i = 0; i < PAGE_WAIT_TABLE_SIZE; i++)
+		init_waitqueue_head(&folio_wait_table[i]);
+
+	page_writeback_init();
+	register_sysctl_init("vm", filemap_sysctl_table);
+}
diff --git a/mm/pagecache_wait.h b/mm/pagecache_wait.h
new file mode 100644
index 0000000000000000000000000000000000000000..79b6d264d10fa81a11fa284bab2d1cf1a8b71d95
--- /dev/null
+++ b/mm/pagecache_wait.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_PAGECACHE_WAIT_H
+#define _MM_PAGECACHE_WAIT_H
+
+#include <linux/wait.h>
+
+/*
+ * In order to wait for pages to become available there must be
+ * waitqueues associated with pages. By using a hash table of
+ * waitqueues where the bucket discipline is to maintain all
+ * waiters on the same queue and wake all when any of the pages
+ * become available, and for the woken contexts to check to be
+ * sure the appropriate page became available, this saves space
+ * at a cost of "thundering herd" phenomena during rare hash
+ * collisions.
+ */
+#define PAGE_WAIT_TABLE_BITS 8
+#define PAGE_WAIT_TABLE_SIZE (1 << PAGE_WAIT_TABLE_BITS)
+extern wait_queue_head_t folio_wait_table[PAGE_WAIT_TABLE_SIZE];
+extern int sysctl_page_lock_unfairness;
+
+#endif
