-static int page_cache_pipe_buf_confirm(struct pipe_inode_info *pipe,
-				       struct pipe_buffer *buf)
-{
-	struct folio *folio = page_folio(buf->page);
-	int err;
-
-	if (!folio_test_uptodate(folio)) {
