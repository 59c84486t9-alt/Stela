-static int simple_xattr_obj_cmpfn(struct rhashtable_compare_arg *arg,
-				   const void *obj)
-{
-	const struct simple_xattr *xattr = obj;
-	const struct sx_key *key = arg->key;
-
-	return xattr->parent != key->parent || strcmp(xattr->name, key->name);
