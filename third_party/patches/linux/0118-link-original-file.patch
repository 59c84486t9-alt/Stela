diff --git a/fs/file_table_init.c b/fs/file_table_init.c
index c17be024af45dcebf8ba2441cad4e9b5aedcd1e2..4a8f467ce24da86770f367008110f3b9ba83d62e 100644
--- a/fs/file_table_init.c
+++ b/fs/file_table_init.c
@@ -6,6 +6,7 @@
  */
 #include <linux/export.h>
 #include <linux/fs.h>
+#include <linux/pid.h>
 #include <linux/slab.h>
 #include <linux/swap.h>
 #include <asm/runtime-const.h>
@@ -15,6 +16,7 @@
 #endif
 
 #include "file_table_init.h"
+#include "internal.h"
 
 /* sysctl tunables... */
 struct files_stat_struct files_stat = {
@@ -80,3 +82,21 @@ void __init files_maxfiles_init(void)
 
 	files_stat.max_files = max_t(unsigned long, n, NR_FILE);
 }
+
+const struct path *backing_file_user_path(const struct file *f)
+{
+	return &container_of(f, struct backing_file, file)->user_path;
+}
+EXPORT_SYMBOL_GPL(backing_file_user_path);
+
+/* Final file owner release from fs/fcntl.c. */
+void file_f_owner_release(struct file *file)
+{
+	struct fown_struct *f_owner;
+
+	f_owner = file_f_owner(file);
+	if (f_owner) {
+		put_pid(f_owner->pid);
+		kfree(f_owner);
+	}
+}
diff --git a/fs/mount_cache.c b/fs/mount_cache.c
index 9fca33e3e877a2acda46b3efb820feff62ca8c2b..5873d2e8b6f562076f37ea5c1d860734a1b9184f 100644
--- a/fs/mount_cache.c
+++ b/fs/mount_cache.c
@@ -1407,3 +1407,33 @@ struct mnt_namespace *get_sequential_mnt_ns(struct mnt_namespace *mntns, bool pr
 		return mntns;
 	}
 }
+
+void dissolve_on_fput(struct vfsmount *mnt)
+{
+	struct mount *m = real_mount(mnt);
+
+	/*
+	 * m used to be the root of anon namespace; if it still is one,
+	 * we need to dissolve the mount tree and free that namespace.
+	 * Let's try to avoid taking namespace_sem if we can determine
+	 * that there's nothing to do without it - rcu_read_lock() is
+	 * enough to make anon_ns_root() memory-safe and once m has
+	 * left its namespace, it's no longer our concern, since it will
+	 * never become a root of anon ns again.
+	 */
+
+	scoped_guard(rcu) {
+		if (!anon_ns_root(m))
+			return;
+	}
+
+	scoped_guard(namespace_excl) {
+		if (!anon_ns_root(m))
+			return;
+
+		emptied_ns = m->mnt_ns;
+		lock_mount_hash();
+		umount_tree(m, UMOUNT_CONNECTED);
+		unlock_mount_hash();
+	}
+}
