diff --git a/mm/kvfree_rcu.c b/mm/kvfree_rcu.c
new file mode 100644
index 0000000000000000000000000000000000000000..4aa728cb91c632a9d753269c947b29bfc2ffe98f
--- /dev/null
+++ b/mm/kvfree_rcu.c
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Slab allocator functions that are independent of the allocator strategy
+ *
+ * (C) 2012 Christoph Lameter <cl@gentwo.org>
+ */
+/* Complete nonbatched RCU-free helpers mechanically separated from slab_common.c.
+ * Bodies, exports and the ordinary Linux callback/free services are unchanged. */
+#include <linux/slab.h>
+#include <linux/kasan.h>
+#include <linux/rcupdate.h>
+#include "slab.h"
+
+#ifndef CONFIG_KVFREE_RCU_BATCHED
+
+void kvfree_call_rcu(struct rcu_head *head, void *ptr)
+{
+	if (head) {
+		kasan_record_aux_stack(ptr);
+		call_rcu(head, kvfree_rcu_cb);
+		return;
+	}
+
+	// kvfree_rcu(one_arg) call.
+	might_sleep();
+	synchronize_rcu();
+	kvfree(ptr);
+}
+EXPORT_SYMBOL_GPL(kvfree_call_rcu);
+
+void __init kvfree_rcu_init(void)
+{
+}
+
+#endif
