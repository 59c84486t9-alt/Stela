diff --git a/fs/inode_evict.c b/fs/inode_evict.c
index f810e0a1746641796b436e74cce7350221742be7..3ad1dcbefe6162cb0bd0d493f453c71f7e6624d1 100644
--- a/fs/inode_evict.c
+++ b/fs/inode_evict.c
@@ -1237,3 +1237,45 @@ long prune_icache_sb(struct super_block *sb, struct shrink_control *sc)
 	inode_dispose_list(&freeable);
 	return freed;
 }
