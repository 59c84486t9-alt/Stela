-		if (!(mask & MAY_WRITE))
-			if (capable_wrt_inode_uidgid(idmap, inode,
-						     CAP_DAC_READ_SEARCH))
-				return 0;
-		if (capable_wrt_inode_uidgid(idmap, inode,
-					     CAP_DAC_OVERRIDE))
-			return 0;
-		return -EACCES;
-	}
