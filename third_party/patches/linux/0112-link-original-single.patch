--- a/fs/mount_cache.h
+++ b/fs/mount_cache.h
@@ -20,7 +20,7 @@ extern struct kmem_cache *mnt_cache;
 #define MNT_UNIQUE_ID_OFFSET (1ULL << 31)
 
 struct mount *alloc_vfsmnt(const char *name);
-void setup_mnt(struct mount *m, struct dentry *root);
+struct mount *clone_mnt(struct mount *old, struct dentry *root, int flag);
 void mnt_free_id(struct mount *mnt);
 int mnt_alloc_group_id(struct mount *mnt);
 void free_vfsmnt(struct mount *mnt);
