-struct timespec64 timestamp_truncate(struct timespec64 t, struct inode *inode)
-{
-	struct super_block *sb = inode->i_sb;
-	unsigned int gran = sb->s_time_gran;
-
-	t.tv_sec = clamp(t.tv_sec, sb->s_time_min, sb->s_time_max);
