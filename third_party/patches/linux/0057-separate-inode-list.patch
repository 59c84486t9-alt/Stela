diff --git a/mm/backing-dev-inode.c b/mm/backing-dev-inode.c
new file mode 100644
index 0000000000000000000000000000000000000000..2912b6edfa9afaa2469bff569879130fad54d4d7
--- /dev/null
+++ b/mm/backing-dev-inode.c
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Inode backing-device selection from mm/backing-dev.c. */
+#include <linux/backing-dev.h>
+#include <linux/blkdev.h>
+#include <linux/export.h>
+
+struct backing_dev_info noop_backing_dev_info;
+EXPORT_SYMBOL_GPL(noop_backing_dev_info);
+
+struct backing_dev_info *inode_to_bdi(struct inode *inode)
+{
+	struct super_block *sb;
+
+	if (!inode)
+		return &noop_backing_dev_info;
+
+	sb = inode->i_sb;
+#ifdef CONFIG_BLOCK
+	if (sb_is_blkdev_sb(sb))
+		return I_BDEV(inode)->bd_disk->bdi;
+#endif
+	return sb->s_bdi;
+}
+EXPORT_SYMBOL(inode_to_bdi);
