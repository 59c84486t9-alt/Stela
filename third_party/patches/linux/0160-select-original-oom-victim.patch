+// SPDX-License-Identifier: GPL-2.0-only
+#ifndef _MM_OOM_VICTIM_H
+#define _MM_OOM_VICTIM_H
+
+#include <linux/types.h>
+
+struct task_struct;
+extern bool oom_killer_disabled;
+void mark_oom_victim(struct task_struct *tsk);
+
+#endif
