-}
-
 #ifdef CONFIG_VMAP_STACK
 /*
  * vmalloc() is a bit slow, and calling vfree() enough times will force a TLB
@@ -472,38 +463,6 @@ void exit_task_stack_account(struct task_struct *tsk)
 	}
 }
 
