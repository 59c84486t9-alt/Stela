+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _FS_NAMESPACE_TREE_H
+#define _FS_NAMESPACE_TREE_H
+
+
+static inline int check_mnt(const struct mount *mnt)
+{
+	return mnt->mnt_ns == current->nsproxy->mnt_ns;
+}
+
+void touch_mnt_namespace(struct mnt_namespace *ns);
+static inline struct mount *node_to_mount(struct rb_node *node)
+{
+	return node ? rb_entry(node, struct mount, mnt_node) : NULL;
+}
+
+void mnt_add_to_ns(struct mnt_namespace *ns, struct mount *mnt);
+bool is_mnt_ns_file(struct dentry *dentry);
