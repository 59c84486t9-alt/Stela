--- a/kernel/rcu/update.c
+++ b/kernel/rcu/update.c
@@ -447,13 +447,6 @@ void __wait_rcu_gp(bool checktiny, unsigned int state, int n, call_rcu_func_t *c
 }
 EXPORT_SYMBOL_GPL(__wait_rcu_gp);
 
-void finish_rcuwait(struct rcuwait *w)
-{
