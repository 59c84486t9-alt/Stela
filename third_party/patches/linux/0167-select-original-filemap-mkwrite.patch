From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tyler Smith <74526874+tylertms@users.noreply.github.com>
Date: Wed, 4 Nov 2026 02:17:32 -0500
Subject: [PATCH] refactor(mm): select original page-cache write fault

---
 mm/Makefile          |  2 +-
 mm/filemap.c         | 31 ------------------------------
 mm/filemap_mkwrite.c | 45 ++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 46 insertions(+), 32 deletions(-)
 create mode 100644 mm/filemap_mkwrite.c

diff --git a/mm/Makefile b/mm/Makefile
index a905f3baf89acf332f671bae0a1b23f7f2bfe1ee..da2ec25fce6967f8e4bbaf759ac9eb66e5a568fe 100644
--- a/mm/Makefile
+++ b/mm/Makefile
@@ -48,7 +48,7 @@ ifdef CONFIG_64BIT
 mmu-$(CONFIG_MMU)	+= mseal.o
 endif
 
-obj-y			:= filemap.o pagecache_init.o folio_wait.o folio_fs.o mempool.o oom_kill.o oom_victim.o oom_adj.o fadvise.o \
+obj-y			:= filemap.o filemap_mkwrite.o pagecache_init.o folio_wait.o folio_fs.o mempool.o oom_kill.o oom_victim.o oom_adj.o fadvise.o \
 			   maccess.o page-writeback.o writeback_io.o writeback_folio.o writeback_domain.o folio-compat.o \
 			   readahead.o swap.o filemap_batch.o truncate.o vmscan.o reclaim_throttle.o shrinker.o \
 			   shmem.o util.o mmzone.o lruvec.o vmstat.o vmstat_init.o backing-dev.o backing-dev-inode.o \
diff --git a/mm/filemap.c b/mm/filemap.c
index e65508171b790850f7c15d2723110ece1be4d5d8..474b57eb888b270b696fb6af21f9731fa5989580 100644
--- a/mm/filemap.c
+++ b/mm/filemap.c
@@ -1322,32 +1322,6 @@ out:
 }
 EXPORT_SYMBOL(filemap_map_pages);
 
-vm_fault_t filemap_page_mkwrite(struct vm_fault *vmf)
-{
-	struct address_space *mapping = vmf->vma->vm_file->f_mapping;
-	struct folio *folio = page_folio(vmf->page);
-	vm_fault_t ret = VM_FAULT_LOCKED;
-
-	sb_start_pagefault(mapping->host->i_sb);
-	file_update_time(vmf->vma->vm_file);
-	folio_lock(folio);
-	if (folio->mapping != mapping) {
-		folio_unlock(folio);
-		ret = VM_FAULT_NOPAGE;
-		goto out;
-	}
-	/*
-	 * We mark the folio dirty already here so that when freeze is in
-	 * progress, we are guaranteed that writeback during freezing will
-	 * see the dirty folio and writeprotect it again.
-	 */
-	folio_mark_dirty(folio);
-	folio_wait_stable(folio);
-out:
-	sb_end_pagefault(mapping->host->i_sb);
-	return ret;
-}
-
 const struct vm_operations_struct generic_file_vm_ops = {
 	.fault		= filemap_fault,
 	.map_pages	= filemap_map_pages,
@@ -1396,10 +1370,6 @@ int generic_file_readonly_mmap_prepare(struct vm_area_desc *desc)
 	return generic_file_mmap_prepare(desc);
 }
 #else
-vm_fault_t filemap_page_mkwrite(struct vm_fault *vmf)
-{
-	return VM_FAULT_SIGBUS;
-}
 int generic_file_mmap(struct file *file, struct vm_area_struct *vma)
 {
 	return -ENOSYS;
@@ -1418,7 +1388,6 @@ int generic_file_readonly_mmap_prepare(struct vm_area_desc *desc)
 }
 #endif /* CONFIG_MMU */
 
-EXPORT_SYMBOL(filemap_page_mkwrite);
 EXPORT_SYMBOL(generic_file_mmap);
 EXPORT_SYMBOL(generic_file_mmap_prepare);
 EXPORT_SYMBOL(generic_file_readonly_mmap);
diff --git a/mm/filemap_mkwrite.c b/mm/filemap_mkwrite.c
new file mode 100644
index 0000000000000000000000000000000000000000..5f2492707b5d8a48a0b310e91c864e5e6138fd2d
--- /dev/null
+++ b/mm/filemap_mkwrite.c
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ *	linux/mm/filemap.c
+ *
+ * Copyright (C) 1994-1999  Linus Torvalds
+ */
+
+#include <linux/fs.h>
+#include <linux/mm.h>
+#include <linux/pagemap.h>
+#include <linux/writeback.h>
+
+#ifdef CONFIG_MMU
+vm_fault_t filemap_page_mkwrite(struct vm_fault *vmf)
+{
+	struct address_space *mapping = vmf->vma->vm_file->f_mapping;
+	struct folio *folio = page_folio(vmf->page);
+	vm_fault_t ret = VM_FAULT_LOCKED;
+
+	sb_start_pagefault(mapping->host->i_sb);
+	file_update_time(vmf->vma->vm_file);
+	folio_lock(folio);
+	if (folio->mapping != mapping) {
+		folio_unlock(folio);
+		ret = VM_FAULT_NOPAGE;
+		goto out;
+	}
+	/*
+	 * We mark the folio dirty already here so that when freeze is in
+	 * progress, we are guaranteed that writeback during freezing will
+	 * see the dirty folio and writeprotect it again.
+	 */
+	folio_mark_dirty(folio);
+	folio_wait_stable(folio);
+out:
+	sb_end_pagefault(mapping->host->i_sb);
+	return ret;
+}
+#else
+vm_fault_t filemap_page_mkwrite(struct vm_fault *vmf)
+{
+	return VM_FAULT_SIGBUS;
+}
+#endif
+EXPORT_SYMBOL(filemap_page_mkwrite);
