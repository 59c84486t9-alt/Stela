diff --git a/kernel/sched/fork_backend.h b/kernel/sched/fork_backend.h
new file mode 100644
index 0000000000000000000000000000000000000000..3fd2c08c5a2c83f7b8fad341ca256938dd0a83fb
--- /dev/null
+++ b/kernel/sched/fork_backend.h
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef STELA_SCHED_FORK_BACKEND_H
+#define STELA_SCHED_FORK_BACKEND_H
+
+#include <linux/types.h>
+
+/* Private interface between original fork metadata and the ONE native owner.
+ * These are required producers, not optional callbacks. This packet defines
+ * none of them and provides no default class, placement, admission or Ready.
+ */
+struct task_struct;
+struct kernel_clone_args;
+
+enum stela_linux_fork_class {
+	STELA_LINUX_FORK_FAIR,
+	STELA_LINUX_FORK_RT,
+	STELA_LINUX_FORK_EXT,
+};
+
+/* Called after original per-task initialization/reset-on-fork/DL-EAGAIN,
+ * immediately before scx_pre_fork. Authenticate the genuine source birth and
+ * same retained native owner/escrow; validate the exact now-final policy/rank,
+ * supported clone/profile operations and actual source class/capacity closure.
+ * Refusal must not precede original __sched_fork: source unwind may depend on
+ * initialized fields rather than copied parent pointers. Genuine original DL
+ * timer/code closure is a link prerequisite, not a callback-presence check.
+ * RR is not FIFO; deadline is not a primitive rank; !SMP is not false topology.
+ *
+ * This bounded metadata call must neither wait nor run/queue a child. Error
+ * means no source/native publication by THIS call; it is not proof that the
+ * caller's existing escrow or original reverse-unwind has retired. Preserve
+ * any typed native refusal in the genuine birth record before returning its
+ * errno to the original fork boundary. Uncertain effects retain/fatal rather
+ * than pretending that a negative errno is a no-publication receipt.
+ */
+int stela_linux_sched_fork_admit(u64 clone_flags, struct task_struct *p);
+
+/* Preserve the original class decision with a genuine source-qualified class
+ * identity and exact post-reset policy/rank, on this same birth/owner. There
+ * is no fake success-only sched_class table in this packet. All reachable
+ * class consumers must be routed to actual native effects, or remain explicit
+ * unsupported dependencies. Do not attach CFS/RT runqueues as a second owner.
+ * No allocation/publication/wait is allowed; task-local fields commit at a
+ * checked no-fail tail from the admission plan retained in the genuine birth.
+ * This MUST NOT return an errno after scx_pre_fork: original sched_fork error
+ * unwind bypasses sched_cancel_fork. A corrupt/uncertain commit retains/fatal.
+ */
+void stela_linux_sched_fork_select(struct task_struct *p,
+				enum stela_linux_fork_class kind);
+
+/* Called with original child pi_lock held, IRQ state saved, before source PID
+ * or task-list visibility. Validate SAME real native reserved placement and
+ * post-reset rank, and perform the genuine source class-fork effects.
+ * FAIR must execute stela_linux_sched_fork_fair_capacity exactly once with
+ * actual source topology/static-key ownership. Original RT has no task_fork
+ * hook; EXT needs its genuine source hook, not FAIR or empty substitution.
+ * This does not activate a native Dormant child or publish source resources.
+ * No waits, original scheduling, capacity allocation or arbitrary callback.
+ * A failure is only an admission error, never a reverse-unwind/cancel receipt.
+ */
+int stela_linux_sched_fork_place(struct task_struct *p,
+			       struct kernel_clone_args *kargs);
+
+/* Actual original capacity helper; not a grant from a CPU number or bool. */
+void stela_linux_sched_fork_fair_capacity(struct task_struct *p);
+/* Exact task-local specialization of original set_load_weight(p, false).
+ * Native scheduler owns runnable reweight/accounting; this leaf synchronizes
+ * genuine source load/inverse metadata after an accepted native nice change.
+ * It neither touches CFS rq nor substitutes an empty update_load=true path. */
+void stela_linux_sched_load_weight(struct task_struct *p);
+
+/* Original enabled helper closures remain unresolved until their real source
+ * implementations/ownership are linked. The disabled original source paths
+ * below are selected by actual configuration, not native success shims.
+ */
+#ifdef CONFIG_UCLAMP_TASK
+void uclamp_update_util_min_rt_default(struct task_struct *p);
+#endif
+#ifdef CONFIG_SCHED_MM_CID
+void sched_mm_cid_fork(struct task_struct *p);
+#endif
+#endif
