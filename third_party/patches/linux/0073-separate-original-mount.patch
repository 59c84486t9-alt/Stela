diff --git a/fs/mount_cache.c b/fs/mount_cache.c
new file mode 100644
index 0000000000000000000000000000000000000000..562195453b4071d65ab999ebe013ae53812979d5
--- /dev/null
+++ b/fs/mount_cache.c
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Mount cache initialization from fs/namespace.c.
+ * (C) Copyright Al Viro 2000, 2001
+ */
+#include <linux/fs.h>
+#include <linux/memblock.h>
+#include <linux/slab.h>
+
+#include "mount.h"
+#include "mount_cache.h"
+
+struct hlist_head *mount_hashtable __ro_after_init;
+struct hlist_head *mountpoint_hashtable __ro_after_init;
+struct kmem_cache *mnt_cache __ro_after_init;
+
+unsigned int m_hash_mask __ro_after_init;
+unsigned int m_hash_shift __ro_after_init;
+unsigned int mp_hash_mask __ro_after_init;
+unsigned int mp_hash_shift __ro_after_init;
+
+static __initdata unsigned long mhash_entries;
+static int __init set_mhash_entries(char *str)
+{
+	return kstrtoul(str, 0, &mhash_entries) == 0;
+}
+__setup("mhash_entries=", set_mhash_entries);
+
+static __initdata unsigned long mphash_entries;
+static int __init set_mphash_entries(char *str)
+{
+	return kstrtoul(str, 0, &mphash_entries) == 0;
+}
+__setup("mphash_entries=", set_mphash_entries);
+
+void __init mnt_cache_init(void)
+{
+	mnt_cache = kmem_cache_create("mnt_cache", sizeof(struct mount),
+			0, SLAB_HWCACHE_ALIGN|SLAB_PANIC|SLAB_ACCOUNT, NULL);
+
+	mount_hashtable = alloc_large_system_hash("Mount-cache",
+				sizeof(struct hlist_head),
+				mhash_entries, 19,
+				HASH_ZERO,
+				&m_hash_shift, &m_hash_mask, 0, 0);
+	mountpoint_hashtable = alloc_large_system_hash("Mountpoint-cache",
+				sizeof(struct hlist_head),
+				mphash_entries, 19,
+				HASH_ZERO,
+				&mp_hash_shift, &mp_hash_mask, 0, 0);
+
+	if (!mount_hashtable || !mountpoint_hashtable)
+		panic("Failed to allocate mount hash table\n");
+}
diff --git a/fs/mount_cache.h b/fs/mount_cache.h
new file mode 100644
index 0000000000000000000000000000000000000000..bffb7838558663952b0a2b59d292c73eca3f58e9
--- /dev/null
+++ b/fs/mount_cache.h
@@ -0,0 +1,17 @@
