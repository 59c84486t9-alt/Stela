-	if (wb_has_dirty_io(wb) &&
-	    !test_bit(WB_start_dontcache, &wb->state) &&
-	    !test_and_set_bit(WB_start_dontcache, &wb->state)) {
-		wb_get(wb);
-		need_wakeup = true;
-	}
