-			zone_stat_mod_folio(folio, NR_ZONE_WRITE_PENDING, -nr);
-			wb_stat_mod(wb, WB_RECLAIMABLE, -nr);
-			ret = true;
-		}
-		unlocked_inode_to_wb_end(inode, &cookie);
-		return ret;
-	}
-	return folio_test_clear_dirty(folio);
-}
-EXPORT_SYMBOL(folio_clear_dirty_for_io);
