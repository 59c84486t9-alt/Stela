index 8165228b7af36ba608245419cbfdf06a568bc35a..7463c3b352def51b0d8f02de2fce21eeafafe7bf 100644
--- a/kernel/sched/Makefile
+++ b/kernel/sched/Makefile
@@ -1,6 +1,7 @@
 # SPDX-License-Identifier: GPL-2.0
 
 CONTEXT_ANALYSIS_core.o := y
+CONTEXT_ANALYSIS_rq_lock.o := y
 CONTEXT_ANALYSIS_wait_support.o := y
 CONTEXT_ANALYSIS_fair.o := y
 
@@ -25,6 +26,7 @@ ifneq ($(CONFIG_SCHED_OMIT_FRAME_POINTER),y)
 # to get a correct value for the wait-channel (WCHAN in ps). --davidm
 CFLAGS_core.o := $(PROFILING) -fno-omit-frame-pointer
 CFLAGS_wait_support.o := $(CFLAGS_core.o)
+CFLAGS_rq_lock.o := $(CFLAGS_core.o)
 endif
 
 # Branch profiling isn't noinstr-safe
@@ -39,7 +41,7 @@ endif
 # These compilation units have roughly the same size and complexity - so their
 # build parallelizes well and finishes roughly at once:
 #
-obj-y += core.o wait_support.o user_affinity.o
+obj-y += core.o rq_lock.o wait_support.o user_affinity.o
 obj-y += fair.o
 obj-y += build_policy.o cputime_group.o rt_timeslice.o
 obj-y += build_utility.o capacity_state.o
