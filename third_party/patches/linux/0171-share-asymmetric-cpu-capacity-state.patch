 kernel/sched/topology.c        |  9 ---------
 7 files changed, 50 insertions(+), 32 deletions(-)
 create mode 100644 kernel/sched/capacity_state.c
 create mode 100644 kernel/sched/fork_capacity.h

diff --git a/kernel/sched/Makefile b/kernel/sched/Makefile
index 4585992a08649dd7aa98b425e2adde485a496432..dbac21902aab670182ae300f75787b039d3d2aea 100644
--- a/kernel/sched/Makefile
+++ b/kernel/sched/Makefile
@@ -42,4 +42,4 @@ endif
 obj-y += core.o wait_support.o user_affinity.o
 obj-y += fair.o
 obj-y += build_policy.o cputime_group.o
-obj-y += build_utility.o
+obj-y += build_utility.o capacity_state.o
diff --git a/kernel/sched/capacity_state.c b/kernel/sched/capacity_state.c
new file mode 100644
index 0000000000000000000000000000000000000000..d3c0ad230d36e5b52a45a70dcd3645dcc29cf2c1
--- /dev/null
+++ b/kernel/sched/capacity_state.c
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Asymmetric capacity state shared with the task-local fork path. */
+#include <linux/jump_label.h>
+#include <linux/list.h>
+
+DEFINE_STATIC_KEY_FALSE(sched_asym_cpucapacity);
+
+/*
+ * Set of available CPUs grouped by their corresponding capacities
+ * Each list entry contains a CPU mask reflecting CPUs that share the same
+ * capacity.
+ * The lifespan of data is unlimited.
+ */
+LIST_HEAD(asym_cap_list);
diff --git a/kernel/sched/fork_capacity.h b/kernel/sched/fork_capacity.h
new file mode 100644
index 0000000000000000000000000000000000000000..a8c5d683b8c2b1ec5ba313080b2a40f0832db899
--- /dev/null
+++ b/kernel/sched/fork_capacity.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef STELA_FORK_CAPACITY_H
+#define STELA_FORK_CAPACITY_H
+
+#include <linux/cpumask.h>
+#include <linux/jump_label.h>
+#include <linux/types.h>
+
+/* Asymmetric CPU capacity bits. */
+struct asym_cap_data {
+	struct list_head link;
+	struct rcu_head rcu;
+	unsigned long capacity;
+	unsigned long cpus[];
+};
+
+extern struct list_head asym_cap_list;
+extern struct static_key_false sched_asym_cpucapacity;
+
+#define cpu_capacity_span(asym_data) to_cpumask((asym_data)->cpus)
+
+static __always_inline bool sched_asym_cpucap_active(void)
+{
+	return static_branch_unlikely(&sched_asym_cpucapacity);
+}
+
+#endif
