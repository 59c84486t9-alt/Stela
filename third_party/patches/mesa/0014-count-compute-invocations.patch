From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tyler Smith <74526874+tylertms@users.noreply.github.com>
Date: Fri, 6 Nov 2026 19:26:47 -0500
Subject: [PATCH] nvk: Count compute invocations in pools that also count
 graphics statistics

---
 src/nouveau/vulkan/nvk_query_pool.c | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/nouveau/vulkan/nvk_query_pool.c b/src/nouveau/vulkan/nvk_query_pool.c
index af6f89fd87223d0b09c87eac04323a8e0cc89242..fad4fc4457a23e06644336c8492c33302a29dbcd 100644
--- a/src/nouveau/vulkan/nvk_query_pool.c
+++ b/src/nouveau/vulkan/nvk_query_pool.c
@@ -669,9 +669,13 @@ nvk_cmd_set_statistics_counters(struct nvk_cmd_buffer *cmd,
          P_1INC(p, NV9097, CALL_MME_MACRO(NVK_MME_SET_STATISTICS_COUNTERS));
          P_INLINE_DATA(p, enable);
          P_INLINE_DATA(p, pool->statistics_counter_mask);
-      } else if (pool->vk.query_type == VK_QUERY_TYPE_PIPELINE_STATISTICS &&
-                 pool->vk.pipeline_statistics &
-                    VK_QUERY_PIPELINE_STATISTIC_COMPUTE_SHADER_INVOCATIONS_BIT) {
+      }
+      /* Compute invocations count in software, whichever graphics
+       * statistics the pool also counts.
+       */
+      if (pool->vk.query_type == VK_QUERY_TYPE_PIPELINE_STATISTICS &&
+          pool->vk.pipeline_statistics &
+             VK_QUERY_PIPELINE_STATISTIC_COMPUTE_SHADER_INVOCATIONS_BIT) {
          cmd->state.cs.active_compute_invocations_query = enable;
       }
       break;
