 impl SimpleLiveness {
+    /// Frees the sets: a pass that replaces them would otherwise hold the
+    /// old and the new at once, each a set of values per block.
+    pub fn release(&mut self) {
+        self.ssa_block_ip = Default::default();
+        self.blocks = Vec::new();
+    }
