From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tyler Smith <74526874+tylertms@users.noreply.github.com>
Date: Mon, 9 Nov 2026 08:10:06 -0500
Subject: [PATCH] nak: Release liveness before rebuilding it and refuse shaders
 whose liveness cannot fit in memory

---
 src/nouveau/compiler/nak/api.rs               | 52 ++++++++++++++++++-
 src/nouveau/compiler/nak/assign_regs.rs       |  2 +
 src/nouveau/compiler/nak/liveness.rs          |  7 +++
 .../compiler/nak/opt_instr_sched_prepass.rs   |  3 ++
 src/nouveau/compiler/nak_nir.c                | 15 ++++++
 src/nouveau/compiler/nak_private.h            |  1 +
 6 files changed, 78 insertions(+), 2 deletions(-)

diff --git a/src/nouveau/compiler/nak/api.rs b/src/nouveau/compiler/nak/api.rs
index aba2b1036e21a8527840bbd6793f8ee8c2779573..45572ab300e21ed5203b9e9a442c8f0fba3aeb80 100644
--- a/src/nouveau/compiler/nak/api.rs
+++ b/src/nouveau/compiler/nak/api.rs
@@ -3,8 +3,8 @@
 
 use crate::from_nir::*;
 use crate::ir::{
-    max_warps_per_sm, ShaderInfo, ShaderIoInfo, ShaderModel, ShaderModelInfo,
-    ShaderStageInfo,
+    max_warps_per_sm, Shader, ShaderInfo, ShaderIoInfo, ShaderModel,
+    ShaderModelInfo, ShaderStageInfo,
 };
 use crate::sph;
 
@@ -515,6 +515,24 @@ fn nak_compile_shader_internal(
     let sm = ShaderModelInfo::new(nak.sm, nak.warps_per_sm);
     let mut s = nak_shader_from_nir(nak, nir, &sm, has_task_shader);
 
+    // Liveness keeps a dense set of the shader's values for every block, so
+    // its memory grows with blocks times values. Give up, with the shader's
+    // name, when that would not fit in the memory left, rather than fail an
+    // allocation midway.
+    let live_set = live_set_bytes(&s);
+    let available = unsafe { nak_available_memory_B() };
+    let room = available - available / LIVENESS_RESERVE_DIVISOR;
+    if live_set.saturating_mul(COMPILE_LIVE_SETS) > room {
+        eprintln!(
+            "NAK: {}: {} blocks x {} values need more memory than the {} MiB left",
+            shader_name(nir),
+            s.functions[0].blocks.len(),
+            s.functions[0].ssa_alloc.max_idx(),
+            available >> 20
+        );
+        return std::ptr::null_mut();
+    }
+
     if DEBUG.print() {
         eprintln!("NAK IR:\n{}", &s);
     }
@@ -556,6 +574,36 @@ fn nak_compile_shader_internal(
     Box::into_raw(bin) as *mut nak_shader_bin
 }
 
+/// The most memory a compilation takes, in [`live_set_bytes`] of the shader
+/// [`nak_shader_from_nir`] makes.
+const COMPILE_LIVE_SETS: u64 = 8;
+/// The share of the available memory a compilation leaves for the rest of
+/// the process: one part in this many.
+const LIVENESS_RESERVE_DIVISOR: u64 = 8;
+
+/// The bytes of one dense live set per block: a bit for each SSA value.
+fn live_set_bytes(s: &Shader<'_>) -> u64 {
+    s.functions
+        .iter()
+        .map(|f| {
+            let blocks = f.blocks.len() as u64;
+            let words = u64::from(f.ssa_alloc.max_idx()).div_ceil(32);
+            blocks * words * 4
+        })
+        .sum()
+}
+
+fn shader_name(nir: *const nir_shader) -> String {
+    let name = unsafe { (*nir).info.name };
+    if name.is_null() {
+        String::from("a shader")
+    } else {
+        unsafe { CStr::from_ptr(name) }
+            .to_string_lossy()
+            .into_owned()
+    }
+}
+
 #[no_mangle]
 pub extern "C" fn nak_compile_shader(
     nir: *mut nir_shader,
