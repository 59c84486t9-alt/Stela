+/* The memory a compilation may still take: what the system has available,
+ * or NAK_AVAILABLE_MEMORY_MB when set, or UINT64_MAX when neither is known.
+ */
+uint64_t
+nak_available_memory_B(void)
+{
+   uint64_t mb = debug_get_num_option("NAK_AVAILABLE_MEMORY_MB", 0);
+   if (mb)
+      return mb << 20;
+   uint64_t size;
+   return os_get_available_system_memory(&size) ? size : UINT64_MAX;
+}
