From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jordan Justen <jordan.l.justen@intel.com>
Date: Fri, 16 Aug 2024 11:51:18 -0700
Subject: [PATCH] brw: Add Xe3P (GFX_VERx10 == 350)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Jordan Justen <jordan.l.justen@intel.com>
Reviewed-by: José Roberto de Souza <jose.souza@intel.com>
Reviewed-by: Lionel Landwerlin <lionel.g.landwerlin@intel.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/43926>

(cherry picked from commit f75a2bd862304b97b85a615c782a66033b333b6c)
---
 src/intel/compiler/intel_gfx_ver_enum.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/intel/compiler/intel_gfx_ver_enum.h b/src/intel/compiler/intel_gfx_ver_enum.h
index 3ceb085d90fb1bd274c1ded10c95aa7de913132b..35302b0a3362ba9511d226f6ac66ef1357984680 100644
--- a/src/intel/compiler/intel_gfx_ver_enum.h
+++ b/src/intel/compiler/intel_gfx_ver_enum.h
@@ -23,6 +23,7 @@ enum gfx_ver {
    GFX125  = (1 << 11),
    XE2     = (1 << 12),
    XE3     = (1 << 13),
+   XE3P    = (1 << 14),
    GFX_ALL = ~0
 };
 
@@ -47,6 +48,7 @@ gfx_ver_from_devinfo(const struct intel_device_info *devinfo)
    case 125: return GFX125;
    case 200: return XE2;
    case 300: return XE3;
+   case 350: return XE3P;
    default:
       UNREACHABLE("not reached");
    }
